-- Notifications
local notifHolder = Instance.new("Frame", gui)
notifHolder.Size = UDim2.fromOffset(280, 400)
notifHolder.Position = UDim2.new(1, -295, 1, -415)
notifHolder.BackgroundTransparency = 1
local layout = Instance.new("UIListLayout", notifHolder)
layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
layout.Padding = UDim.new(0, 8)

local function notify(text, sub2)
    local n = Instance.new("Frame", notifHolder)
    n.Size = UDim2.fromOffset(280, 64)
    n.BackgroundColor3 = Color3.fromRGB(24, 24, 34)
    n.BackgroundTransparency = 1
    Instance.new("UICorner", n).CornerRadius = UDim.new(0, 12)
    local s = Instance.new("UIStroke", n)
    s.Color = Color3.fromRGB(0, 200, 110)
    s.Thickness = 1.5
    s.Transparency = 1

    local icon = Instance.new("ImageLabel", n)
    icon.Size = UDim2.fromOffset(40, 40)
    icon.Position = UDim2.fromOffset(12, 12)
    icon.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
    icon.Image = pfp.Image
    icon.ImageTransparency = 1
    Instance.new("UICorner", icon).CornerRadius = UDim.new(1, 0)

    local t1 = Instance.new("TextLabel", n)
    t1.Size = UDim2.new(1, -66, 0, 24)
    t1.Position = UDim2.fromOffset(60, 10)
    t1.BackgroundTransparency = 1
    t1.Text = text
    t1.TextColor3 = Color3.new(1, 1, 1)
    t1.Font = Enum.Font.GothamBold
    t1.TextSize = 14
    t1.TextXAlignment = Enum.TextXAlignment.Left
    t1.TextTransparency = 1

    local t2 = Instance.new("TextLabel", n)
    t2.Size = UDim2.new(1, -66, 0, 20)
    t2.Position = UDim2.fromOffset(60, 34)
    t2.BackgroundTransparency = 1
    t2.Text = sub2
    t2.TextColor3 = Color3.fromRGB(0, 220, 120)
    t2.Font = Enum.Font.Gotham
    t2.TextSize = 12
    t2.TextXAlignment = Enum.TextXAlignment.Left
    t2.TextTransparency = 1

    local ti = TweenInfo.new(0.3)
    TweenService:Create(n, ti, {BackgroundTransparency = 0}):Play()
    TweenService:Create(s, ti, {Transparency = 0}):Play()
    TweenService:Create(icon, ti, {ImageTransparency = 0}):Play()
    TweenService:Create(t1, ti, {TextTransparency = 0}):Play()
    TweenService:Create(t2, ti, {TextTransparency = 0}):Play()

    task.delay(3, function()
        local out = TweenInfo.new(0.4)
        TweenService:Create(n, out, {BackgroundTransparency = 1}):Play()
        TweenService:Create(s, out, {Transparency = 1}):Play()
        TweenService:Create(icon, out, {ImageTransparency = 1}):Play()
        TweenService:Create(t1, out, {TextTransparency = 1}):Play()
        TweenService:Create(t2, out, {TextTransparency = 1}):Play()
        task.wait(0.45)
        n:Destroy()
    end)
end

-- Logic
local function refresh()
    gemBtn.BackgroundColor3 = selected == "Gem" and Color3.fromRGB(80, 80, 255) or Color3.fromRGB(45, 45, 60)
    beliBtn.BackgroundColor3 = selected == "Beli" and Color3.fromRGB(80, 80, 255) or Color3.fromRGB(45, 45, 60)
    local v = data:FindFirstChild(selected)
    if v then box.Text = tostring(v.Value) end
end

gemBtn.MouseButton1Click:Connect(function() selected = "Gem" refresh() end)
beliBtn.MouseButton1Click:Connect(function() selected = "Beli" refresh() end)

run.MouseButton1Click:Connect(function()
    local n = tonumber(box.Text)
    local v = data:FindFirstChild(selected)
    if n and v then
        v.Value = n
        notify(selected .. " Bypass", "✔ Bypassed " .. selected .. " → " .. tostring(n))
    else
        notify("Error", "Enter a valid number")
    end
end)

refresh()
notify("Fake Value", "Loaded successfully")
