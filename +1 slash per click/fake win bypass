-- Suffix support: K up to Vg (past DDe)
local suffixes = {
    {"K", 3}, {"M", 6}, {"B", 9}, {"T", 12}, {"Qa", 15}, {"Qi", 18},
    {"Sx", 21}, {"Sp", 24}, {"Oc", 27}, {"No", 30}, {"De", 33},
    {"UDe", 36}, {"DDe", 39}, {"TDe", 42}, {"QaDe", 45}, {"QiDe", 48},
    {"SxDe", 51}, {"SpDe", 54}, {"OcDe", 57}, {"NoDe", 60}, {"Vg", 63},
}

local suffixMap = {}
for _, s in ipairs(suffixes) do
    suffixMap[s[1]:lower()] = s[2]
end

local function parseValue(text)
    text = text:gsub("[%s,]", "")
    local num, suf = text:match("^(%-?[%d%.]+)(%a*)$")
    num = tonumber(num)
    if not num then return nil end
    if suf == "" then return num end
    local exp = suffixMap[suf:lower()]
    if not exp then return nil end
    return num * 10 ^ exp
end

local function formatValue(n)
    for i = #suffixes, 1, -1 do
        local s = suffixes[i]
        local base = 10 ^ s[2]
        if math.abs(n) >= base then
            local str = string.format("%.2f", n / base)
            str = str:gsub("(%.%d-)0+$", "%1")
            str = str:gsub("%.$", "")
            return str .. s[1]
        end
    end
    return tostring(n)
end

