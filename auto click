-- helpers
local function make(class, props, par)
	local o = Instance.new(class)
	for k, v in pairs(props) do o[k] = v end
	o.Parent = par
	return o
end
local function corner(o, r) return make("UICorner", { CornerRadius = UDim.new(0, r) }, o) end
local function stroke(o, c, t)
	return make("UIStroke", { Color = c or COL.dark, Thickness = t or 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, o)
end
local function label(par, text, x, y, w, h, size, color)
	return make("TextLabel", {
		Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h),
		BackgroundTransparency = 1, Text = text, Font = Enum.Font.Arcade,
		TextSize = size or 14, TextColor3 = color or COL.white,
		TextStrokeTransparency = 0, TextXAlignment = Enum.TextXAlignment.Left,
	}, par)
end
local function button(par, text, x, y, w, h, color)
	local b = make("TextButton", {
		Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h),
		BackgroundColor3 = color, Text = text, Font = Enum.Font.Arcade,
		TextSize = 14, TextColor3 = COL.white, TextStrokeTransparency = 0,
