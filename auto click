local function calTarget()
	local t1 = triggers[1]
	if t1 and t1.marker.Parent then
		return t1.marker.AbsolutePosition + t1.marker.AbsoluteSize / 2
	end
	return cam.ViewportSize / 2
end
-- moves the real mouse to the target and shows where it really went
local function measure()
	local tgt = calTarget()
	VIM:SendMouseMoveEvent(tgt.X + offX, tgt.Y + offY, game)
	task.wait(0.15)
	local m = UIS:GetMouseLocation()
	ping(tgt.X, tgt.Y, COL.coin)
	ping(m.X, m.Y, COL.red)
	return tgt, m
end
