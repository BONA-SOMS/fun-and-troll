-- keyboard typing (numbers / words)
local DIGITS = { "Zero", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine" }
local function keyFor(ch)
	if ch:match("%d") then return Enum.KeyCode[DIGITS[tonumber(ch) + 1]] end
	if ch:match("%a") then return Enum.KeyCode[ch:upper()] end
	if ch == " " then return Enum.KeyCode.Space end
	if ch == "." then return Enum.KeyCode.Period end
	if ch == "-" then return Enum.KeyCode.Minus end
end
local function tapKey(k, shift)
	if shift then VIM:SendKeyEvent(true, Enum.KeyCode.LeftShift, false, game) end
	VIM:SendKeyEvent(true, k, false, game)
	task.wait()
	VIM:SendKeyEvent(false, k, false, game)
	if shift then VIM:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game) end
end
local function typeEntry(entry)
	local named = entry:match("^%[(.+)%]$") -- [Enter], [Space], [F1] ...
	if named then
		local ok, k = pcall(function() return Enum.KeyCode[named] end)
		if ok and k then tapKey(k) end
		return
	end
	for ch in entry:gmatch(".") do
		local k = keyFor(ch)
		if k then tapKey(k, ch:match("%u") ~= nil); task.wait(0.02) end
	end
	if pressEnter then tapKey(Enum.KeyCode.Return) end
end
local function parseKeys()
	local out = {}
	for part in keysBox.Text:gmatch("[^,]+") do
		part = part:match("^%s*(.-)%s*$")
		if part ~= "" then table.insert(out, part) end
	end
	return out
end

-- trigger creation
local editor, curT, refreshEditor

local function refreshCount()
	countLbl.Text = "TRIGGERS " .. #triggers .. "/" .. MAX_TRIGGERS
end

local function removeTrigger(t)
	for i, v in ipairs(triggers) do
		if v == t then table.remove(triggers, i) break end
	end
	for _, c in ipairs(t.conns) do c:Disconnect() end
	if curT == t and editor then editor.Visible = false; curT = nil end
	t.marker:Destroy(); t.row:Destroy()
	refreshCount()
end

local serial = 0
local DEFAULT_SIZE = 26
local edName, edSize, edOn

local function applySize(t, n)
	n = math.clamp(math.floor(tonumber(n) or DEFAULT_SIZE), 12, 90)
	t.size = n
	t.marker.Size = UDim2.fromOffset(n, n)
	return n
end
local function applyName(t, txt)
	if txt == nil or txt == "" then txt = t.defaultName end
	t.name = txt
	t.tag.Text = " " .. txt .. " "
	t.nameBox.Text = txt
	if curT == t and edName then edName.Text = txt end
end
local function applyEnabled(t, on)
	t.enabled = on
	t.onBtn.Text = on and "ON" or "OFF"
	t.onBtn.BackgroundColor3 = on and COL.green or COL.gray
	t.marker.BackgroundTransparency = on and 0.1 or 0.7
	if curT == t then refreshEditor() end
end

