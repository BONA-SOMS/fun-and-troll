local function addTrigger(nameOverride)
	if #triggers >= MAX_TRIGGERS then setStatus("MAX TRIGGERS REACHED") return end
	serial += 1
	local idx = #triggers + 1
	local t = { defaultName = tostring(idx), enabled = true, conns = {}, size = DEFAULT_SIZE }
	local vp = cam.ViewportSize

	local marker = make("Frame", {
		Size = UDim2.fromOffset(DEFAULT_SIZE, DEFAULT_SIZE), AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(vp.X / 2 + ((idx - 1) % 8) * 36 - 126, vp.Y / 2 + math.floor((idx - 1) / 8) * 36),
		BackgroundColor3 = COL.coin, BackgroundTransparency = 0.1, Active = not running, ZIndex = 50,
	}, layer)
	make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, marker)
	stroke(marker, COL.dark, 2)
	local dot = make("Frame", { Size = UDim2.fromOffset(4, 4), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundColor3 = COL.dark, ZIndex = 51 }, marker)
	make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, dot)
	local tag = make("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 0, -3), AutomaticSize = Enum.AutomaticSize.XY,
		Size = UDim2.fromOffset(0, 0), BackgroundColor3 = COL.dark, BackgroundTransparency = 0.25,
		Font = Enum.Font.Arcade, TextSize = 11, TextColor3 = COL.white, Text = "", ZIndex = 52,
	}, marker)
	corner(tag, 3)
	t.marker, t.tag = marker, tag

	-- drag to move, tap (no movement) to open the editor
	for _, c in ipairs(makeDraggable(marker, marker)) do table.insert(t.conns, c) end
	table.insert(t.conns, marker.InputBegan:Connect(function(i)
		if running then return end
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			local start = i.Position
			i.Changed:Connect(function()
				if i.UserInputState == Enum.UserInputState.End and (i.Position - start).Magnitude < 8 then
					openEditor(t)
				end
			end)
		end
	end))

	local row = make("Frame", { Size = UDim2.new(1, -4, 0, 28), BackgroundColor3 = COL.white, LayoutOrder = serial, ZIndex = 103 }, list)
	corner(row, 5); stroke(row, COL.dark, 2)
	t.nameBox = box(row, "", 3, 2, 94, 24); t.nameBox.ZIndex = 104
	local setBtn = button(row, "SET", 101, 2, 48, 24, COL.blue); setBtn.ZIndex = 104
	t.onBtn = button(row, "ON", 153, 2, 46, 24, COL.green); t.onBtn.ZIndex = 104
	local delBtn = button(row, "X", 203, 2, 44, 24, COL.red); delBtn.ZIndex = 104
	t.row = row

	applyName(t, nameOverride)
	t.nameBox.FocusLost:Connect(function() applyName(t, t.nameBox.Text) end)
	setBtn.MouseButton1Click:Connect(function() openEditor(t) end)
	t.onBtn.MouseButton1Click:Connect(function() applyEnabled(t, not t.enabled) end)
	delBtn.MouseButton1Click:Connect(function() removeTrigger(t) end)

	table.insert(triggers, t)
	refreshCount()
end

