-- start / stop
local function stopClicking(msg)
	running = false
	startBtn.Text = "START"
	startBtn.BackgroundColor3 = COL.green
	setMarkersActive(true)
	setStatus(msg or ("STOPPED  |  CLICKS: " .. done))
end

local function startClicking()
	if running then return end
	if not useMouse and not useTriggers and not useKeys then setStatus("TURN ON MOUSE, TRIG OR KEYS") return end
	if useKeys and #parseKeys() == 0 and not useMouse and not useTriggers then setStatus("TYPE KEYS FIRST (1,2,hello)") return end
	if useTriggers and not useMouse and not useKeys then
		local any = false
		for _, t in ipairs(triggers) do if t.enabled then any = true break end end
		if not any then setStatus("ADD / ENABLE A TRIGGER FIRST") return end
	end
	local interval = clampDelay()
	local keyList = parseKeys()
	local maxClicks = getMaxClicks()
	running = true
	done = 0
	editor.Visible = false
	calWin.Visible = false
	startBtn.Text = "STOP"
	startBtn.BackgroundColor3 = COL.red
	setMarkersActive(false) -- markers no longer block the click
	task.spawn(function()
		while running do
			if useMouse then
				local m = UIS:GetMouseLocation()
				clickAt(m.X, m.Y)
			end
			if useTriggers then
				for _, t in ipairs(triggers) do
					if not running then break end
					if t.enabled and t.marker.Parent then
						local p = t.marker.AbsolutePosition + t.marker.AbsoluteSize / 2
						clickAt(p.X, p.Y)
						local m = t.marker
						m.BackgroundColor3 = COL.red
						task.delay(0.08, function() if m.Parent then m.BackgroundColor3 = COL.coin end end)
					end
				end
			end
			if useKeys then
				for _, entry in ipairs(keyList) do
					if not running then break end
					typeEntry(entry)
					task.wait(0.03)
				end
			end
			done += 1
			setStatus("RUNNING  |  CLICKS: " .. done .. (maxClicks > 0 and ("/" .. maxClicks) or ""))
			if maxClicks > 0 and done >= maxClicks then
				stopClicking("DONE  |  CLICKS: " .. done)
				break
			end
			task.wait(interval)
		end
	end)
end

-- events
addBtn.MouseButton1Click:Connect(function() addTrigger() end)
clearBtn.MouseButton1Click:Connect(function()
	for i = #triggers, 1, -1 do removeTrigger(triggers[i]) end
end)
startBtn.MouseButton1Click:Connect(function()
	if running then stopClicking() else startClicking() end
end)
mouseBtn.MouseButton1Click:Connect(function()
	useMouse = not useMouse
	toggleStyle(mouseBtn, useMouse, "MOUSE")
end)
trigBtn.MouseButton1Click:Connect(function()
	useTriggers = not useTriggers
	toggleStyle(trigBtn, useTriggers, "TRIG")
end)
keysBtn.MouseButton1Click:Connect(function()
	useKeys = not useKeys
	toggleStyle(keysBtn, useKeys, "KEYS")
end)
enterBtn.MouseButton1Click:Connect(function()
	pressEnter = not pressEnter
	enterBtn.BackgroundColor3 = pressEnter and COL.green or COL.gray
end)
delayBox.FocusLost:Connect(clampDelay)
clicksBox.FocusLost:Connect(getMaxClicks)
unitBtn.MouseButton1Click:Connect(function()
	local v = tonumber(delayBox.Text) or 100
	unitSec = not unitSec
	if unitSec then
		delayBox.Text = tostring(v / 1000); unitBtn.Text = "SEC"
	else
		delayBox.Text = tostring(v * 1000); unitBtn.Text = "MS"
	end
	clampDelay()
end)

local minimized = false
minBtn.MouseButton1Click:Connect(function()
	minimized = not minimized
	body.Visible = not minimized
	ground.Visible = not minimized
	main.Size = minimized and UDim2.fromOffset(290, 36) or UDim2.fromOffset(290, H)
end)

local hotkeyConn = UIS.InputBegan:Connect(function(i, gp)
	if gp then return end
	if i.KeyCode == Enum.KeyCode.F6 then
		if running then stopClicking() else startClicking() end
	end
end)

closeBtn.MouseButton1Click:Connect(function()
	running = false
	hotkeyConn:Disconnect()
	for _, t in ipairs(triggers) do for _, c in ipairs(t.conns) do c:Disconnect() end end
	gui:Destroy()
end)

