local function setStatus(t) status.Text = t end

local function toggleStyle(btn, on, name)
	btn.Text = name .. (on and ": ON" or ": OFF")
	btn.BackgroundColor3 = on and COL.green or COL.gray
end

local function clampDelay()
	local v = tonumber(delayBox.Text) or 100
	local ms = unitSec and v * 1000 or v
	if ms < MIN_MS then
		ms = MIN_MS
		v = unitSec and ms / 1000 or ms
	end
	delayBox.Text = tostring(v)
	return ms / 1000
end

local function getMaxClicks()
	local n = math.floor(tonumber(clicksBox.Text) or 0)
	if n < 0 then n = 0 end
	clicksBox.Text = tostring(n)
	return n
end

local offX, offY = 0, 0 -- calibration offset (use the CAL button)
local sendTouch = false
local function clickAt(x, y)
	x += offX; y += offY
	if sendTouch then
		pcall(function() VIM:SendTouchEvent(1, 0, x, y) end)
		task.wait()
		pcall(function() VIM:SendTouchEvent(1, 2, x, y) end)
	else
		VIM:SendMouseButtonEvent(x, y, 0, true, game, 0)
		task.wait()
		VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
	end
end

