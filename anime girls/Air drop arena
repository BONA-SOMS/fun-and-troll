if type(ProjectileManager) == "table" and type(ProjectileManager.CreateProjectile) == "function" then
	installHook(ProjectileManager.CreateProjectile, "createProjectile", function(manager, spawn, ...)
		if
			session.alive
			and session.on
			and preferences.snapProjectile
			and session.aimPosition
			and type(spawn) == "table"
			and spawn.isLocal
		then
			local aim = session.aimPosition
			local start = spawn.startPosition
			if typeof(aim) == "Vector3" and typeof(start) == "Vector3" then
				local offset = aim - start
				if offset.Magnitude > 0 then
					local range = if typeof(spawn.direction) == "Vector3" then spawn.direction.Magnitude else offset.Magnitude
					spawn.direction = offset.Unit * range
					spawn.startPosition = aim - offset.Unit * 2
					spawn.endPosition = aim
				end
			end
		end
		return originals.createProjectile(manager, spawn, ...)
	end)
end

if type(Blaster.GetRateOfFire) == "function" then
