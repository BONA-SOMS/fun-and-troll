local function aimPart(entity): BasePart?
	if not entity then
		return nil
	end
	if preferences.aimHead then
		local head = entity:FindFirstChild("Head")
		if head and head:IsA("BasePart") then
			return head
		end
	end
	local primary = entity.PrimaryPart
	if primary and primary:IsA("BasePart") then
		return primary
	end
	return nil
end

local function isVisible(camera: Camera, part: BasePart): boolean
	local origin = camera.CFrame.Position
	visibilityParams.FilterDescendantsInstances = { localPlayer.Character, camera }
	local hit = Workspace:Raycast(origin, (part.Position - origin) * 1.05, visibilityParams)
	return hit == nil or hit.Instance:IsDescendantOf(part.Parent)
end

local function screenGap(camera: Camera, part: BasePart, point: Vector2): number?
	if (part.Position - camera.CFrame.Position).Magnitude > CONFIG.maxStuds then
		return nil
	end
	local screen, onScreen = camera:WorldToViewportPoint(part.Position)
	if not onScreen or screen.Z <= 0 then
		return nil
	end
	local gap = (Vector2.new(screen.X, screen.Y) - point).Magnitude
	if gap > preferences.fieldOfView then
		return nil
	end
	if preferences.wallCheck and not isVisible(camera, part) then
		return nil
	end
	return gap
end

local function consider(entityId, camera: Camera, point: Vector2, nearestId, nearestPart: BasePart?, nearestGap: number)
	if entityId == localPlayer.UserId then
		return nearestId, nearestPart, nearestGap
	end
	local entity = EntityManager:GetInstance(entityId)
	if not (entity and BattlefieldHelper.IsFoeFaction(entity) and EntityHelper.IsLife(entity)) then
		return nearestId, nearestPart, nearestGap
	end
	local part = aimPart(entity)
	local gap = part and screenGap(camera, part, point)
	if gap and gap < nearestGap then
		return entityId, part, gap
	end
	return nearestId, nearestPart, nearestGap
end

local function pickTarget()
	local camera = Workspace.CurrentCamera
	if not camera then
		stickyId = nil
		session.aimPosition = nil
		session.aimPart = nil
		return
	end
	local viewport = camera.ViewportSize
	local point = Vector2.new(viewport.X / 2, viewport.Y / 2)
	if stickyId then
		local entity = EntityManager:GetInstance(stickyId)
		local part = entity and aimPart(entity)
		if
			entity
			and BattlefieldHelper.IsFoeFaction(entity)
			and EntityHelper.IsLife(entity)
			and part
			and screenGap(camera, part, point)
		then
			session.aimPart = part
			session.aimPosition = part.Position
			return
		end
		stickyId = nil
	end
	local nearestId = nil
	local nearestPart = nil
	local nearestGap = math.huge
	local players = EntityManager:GetEntityIds(EntityType.player)
	if players then
		for _, entityId in ipairs(players) do
			nearestId, nearestPart, nearestGap = consider(entityId, camera, point, nearestId, nearestPart, nearestGap)
		end
	end
	local monsters = EntityManager:GetEntityIds(EntityType.monster)
	if monsters then
		for _, entityId in ipairs(monsters) do
			nearestId, nearestPart, nearestGap = consider(entityId, camera, point, nearestId, nearestPart, nearestGap)
		end
	end
	stickyId = nearestId
	session.aimPart = nearestPart
	session.aimPosition = if nearestPart then nearestPart.Position else nil
end

