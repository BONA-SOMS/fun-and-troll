local Bag = {}

local function release(item: Disposable)
	if type(item) == "function" then
		item()
	elseif type(item) == "thread" then
		if item ~= coroutine.running() and coroutine.status(item) ~= "dead" then
			task.cancel(item)
		end
	elseif typeof(item) == "Instance" then
		item:Destroy()
	else
		item:Disconnect()
	end
end

function Bag.add(self: CleanupBag, item: Disposable): Disposable
	if self.closed then
		release(item)
	else
		table.insert(self.items, item)
	end
	return item
end

function Bag.clean(self: CleanupBag)
	self.closed = true
	local items = self.items
	self.items = {}
	for index = #items, 1, -1 do
		xpcall(release, function(problem)
			report(`cleanup: {problem}`)
		end, items[index])
	end
end

function Bag.guard(self: CleanupBag, callback: (...any) -> ()): (...any) -> ()
	return function(...)
		if self.closed or not session.alive then
			return
		end
		callback(...)
	end
end

function Bag.new(): CleanupBag
	return {
		items = {},
		closed = false,
		add = Bag.add,
		clean = Bag.clean,
		guard = Bag.guard,
	}
end

