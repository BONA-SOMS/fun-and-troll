local function isLocalBlaster(blaster): boolean
	return type(blaster) == "table" and type(blaster.IsLocalPlayer) == "function" and blaster:IsLocalPlayer() == true
end

local function aimOrigin(): CFrame?
	local camera = Workspace.CurrentCamera
	local aim = session.aimPosition
	if not camera or typeof(aim) ~= "Vector3" then
		return nil
	end
	return CFrame.lookAt(camera.CFrame.Position, aim)
end

local function fillDirections(origin: CFrame, count: number, range: number): { Vector3 }
	local look = origin.LookVector * range
	local directions = table.create(count)
	for index = 1, count do
		directions[index] = look
	end
	return directions
end

local function redirectBase(blaster, leftMuzzle)
	local origin = aimOrigin()
	if not origin then
		return originals.base(blaster, leftMuzzle)
	end
	blaster:Recoil()
	blaster:PlayFireVFX(nil, leftMuzzle)
	local range = blaster:GetRange()
	local directions = fillDirections(origin, blaster:GetRaysPerShot(), range)
	return origin, directions, BlasterUtility.CastRays(localPlayer, origin.Position, directions, blaster:GetRayRadius())
end

local function redirectExplosive(blaster, leftMuzzle)
	local origin = aimOrigin()
	if not origin then
		return originals.explosive(blaster, leftMuzzle)
	end
	blaster:Recoil()
	blaster:PlayFireVFX(nil, leftMuzzle)
	local range = blaster:GetRange()
	local directions = fillDirections(origin, blaster:GetRaysPerShot(), range)
	local config = blaster.config
	return origin, directions, BlasterUtility.CastExplosiveRays(
		localPlayer,
		origin.Position,
		directions,
		blaster:GetRayRadius(),
		config and config.explosionRadius or 20
	)
end

local function redirectRico(blaster, leftMuzzle)
	local origin = aimOrigin()
	if not origin then
		return originals.rico(blaster, leftMuzzle)
	end
	blaster:Recoil()
	blaster:PlayFireVFX(nil, leftMuzzle)
	local range = blaster:GetRange()
	local directions = fillDirections(origin, blaster:GetRaysPerShot(), range)
	local results = BlasterUtility.CastRays(localPlayer, origin.Position, directions, blaster:GetRayRadius())
	local look = origin.LookVector
	for _, result in results do
		result.segStart = origin.Position
		result.segDirection = look
	end
	return origin, directions, results
end

local function redirectRocket(blaster, leftMuzzle)
	local origin = aimOrigin()
	if not origin then
		return originals.rocket(blaster, leftMuzzle)
	end
	blaster:Recoil()
	blaster:PlayFireVFX(nil, leftMuzzle)
	local range = blaster:GetRange()
	local count = blaster:GetRaysPerShot()
	local directions = fillDirections(origin, count, range)
	local results = table.create(count)
	for index = 1, count do
		results[index] = {
			taggedEntityId = nil,
			distance = range,
		}
	end
	return origin, directions, results
end

local function redirectDagger(blaster, ...)
	local origin = aimOrigin()
	if not origin then
		return originals.dagger(blaster, ...)
	end
	blaster:Recoil()
	local range = blaster:GetRange()
	local directions = fillDirections(origin, 1, range)
	local results = BlasterUtility.CastRays(localPlayer, origin.Position, directions, 0.2, nil, true)
	if not results[1] or not results[1].taggedEntityId then
		results = BlasterUtility.CastRays(localPlayer, origin.Position, directions, blaster:GetRayRadius(), nil, true)
	end
	return origin, directions, results
end

local function wrapShot(kind: string, redirect)
	return function(blaster, ...)
		if not (session.alive and session.on and session.aimPosition and isLocalBlaster(blaster)) then
			return originals[kind](blaster, ...)
		end
		local ok, origin, directions, results = pcall(redirect, blaster, ...)
		if ok then
			return origin, directions, results
		end
		return originals[kind](blaster, ...)
	end
end

local function installHook(target, kind: string, wrapper)
	if type(target) ~= "function" then
		return
	end
	local original
	original = hookfunction(target, newcclosure(function(...)
		return wrapper(...)
	end))
	originals[kind] = original
	table.insert(hooked, {
		target = target,
		original = original,
	})
end

