local function readHalcyonSource(): string?
	local isfile, readfile, writefile, isfolder, makefolder =
		isfile, readfile, writefile, isfolder, makefolder
	if isfile and readfile then
		local cached, body = pcall(function()
			return if isfile(CONFIG.halcyonCache) then readfile(CONFIG.halcyonCache) else nil
		end)
		if cached and type(body) == "string" and #body > 0 then
			return body
		end
	end
	local request = request or http_request
	if not request then
		return nil
	end
	local fetched, response = pcall(request, {
		Url = CONFIG.halcyonPin,
		Method = "GET",
	})
	if
		not (
			fetched
			and type(response) == "table"
			and response.Success
			and type(response.Body) == "string"
			and #response.Body > 0
		)
	then
		return nil
	end
	local body = response.Body
	if writefile and isfolder and makefolder then
		pcall(function()
			if not isfolder(SETTINGS_FOLDER) then
				makefolder(SETTINGS_FOLDER)
			end
			writefile(CONFIG.halcyonCache, body)
		end)
	end
	return body
end

local function startHub(): boolean
	local source = readHalcyonSource()
	if not source then
		return false
	end
	local compiled, compileProblem = loadstring(source, "Halcyon")
	if not compiled then
		report(`Halcyon did not compile: {compileProblem}`)
		return false
	end
	local loaded, library = pcall(compiled)
	if not (loaded and type(library) == "table" and type(library.CreateWindow) == "function") then
		report("Halcyon failed to load")
		return false
	end

	local announceToggles = false
	local window = library:CreateWindow({
		Title = "BONA - AIRDROP ARENA",
		Icon = "crosshair",
		Folder = SETTINGS_FOLDER,
		Size = Vector2.new(620, 460),
		TabStyle = "Rail",
		Theme = "Onyx",
		OpenButton = true,
		MinimizeStyle = "Pill",
		ToggleKey = Enum.KeyCode.RightShift,
	})
	if not window then
		return false
	end

	local function notifyToggle(name: string, on: boolean)
		if not announceToggles then
			return
		end
		window:Notify({
			Title = "YS HUB - AIRDROP ARENA",
			Content = if on then `{name} enabled` else `{name} disabled`,
			Kind = if on then "success" else "info",
			Duration = 3,
		})
	end

	local function persistConfig()
		if not announceToggles then
			return
		end
		local saved, problem = pcall(function()
			local name = window:GetAutoload()
			if type(name) ~= "string" or name == "" then
				name = "current"
				local pinned, pinProblem = window:SetAutoload(name)
				if not pinned then
					error(pinProblem or "autoload not set", 0)
				end
			end
			local wrote, writeProblem = window:SaveConfig(name)
			if not wrote then
				error(writeProblem or "config not saved", 0)
			end
		end)
		if not saved then
			report(`config not saved: {problem}`)
		end
	end

	local function keepSetting(key: string, name: string)
		return function(on: boolean)
			preferences[key] = on
			session.savePreferences()
			persistConfig()
			notifyToggle(name, on)
		end
	end

	local hubWindow = window
	window.OnUnload:Connect(function()
		hubWindow = nil
		if session.alive then
			session.unload()
		end
	end)
	root:add(function()
		local current = hubWindow
		hubWindow = nil
		if current then
			pcall(function()
				current:Unload()
			end)
		end
	end)

	local UserInputService = game:GetService("UserInputService")
	local savedMouseBehavior = nil
	local savedMouseIcon = nil
	local silentAim

	local function restoreCursor()
		if savedMouseBehavior ~= nil then
			UserInputService.MouseBehavior = savedMouseBehavior
			if savedMouseIcon ~= nil then
				UserInputService.MouseIconEnabled = savedMouseIcon
			end
			savedMouseBehavior = nil
			savedMouseIcon = nil
		end
	end

	local function applyCursorLock()
		if not (preferences.lockCursor and window.Visible) then
			restoreCursor()
			return
		end
		if savedMouseBehavior == nil then
			savedMouseBehavior = UserInputService.MouseBehavior
			savedMouseIcon = UserInputService.MouseIconEnabled
		end
		if UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default then
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		end
		if not UserInputService.MouseIconEnabled then
			UserInputService.MouseIconEnabled = true
		end
	end

	root:add(restoreCursor)
	root:add(RunService.Heartbeat:Connect(root:guard(function()
		if preferences.lockCursor then
			applyCursorLock()
		end
	end)))

	local combat = window:Tab({
		Title = "Combat",
		Icon = "crosshair",
	})
	local aim = combat:Section({ Title = "Aim", Icon = "target" })
	silentAim = aim:Toggle({
		Title = "Silent aim",
		Default = preferences.silentAim,
		Flag = "silentAim",
		Keybind = {
			Default = CONFIG.toggleKey,
			Mode = "Toggle",
			Flag = "silentAimKey",
		},
		Callback = function(on)
			setArmed(on)
			preferences.silentAim = on
			session.savePreferences()
			persistConfig()
			notifyToggle("Silent aim", on)
		end,
	})
	aim:Slider({
		Title = "Field of view",
		Min = 40,
		Max = 700,
		Default = preferences.fieldOfView,
		Suffix = " px",
		Live = false,
		Flag = "fieldOfView",
		Callback = function(value)
			preferences.fieldOfView = value
			session.savePreferences()
			persistConfig()
		end,
	})
	local targeting = aim:Group({ Columns = 2 })
	targeting:Toggle({
		Title = "Wall check",
		Default = preferences.wallCheck,
		Flag = "wallCheck",
		Callback = keepSetting("wallCheck", "Wall check"),
	})
	targeting:Toggle({
		Title = "Aim head",
		Default = preferences.aimHead,
		Flag = "aimHead",
		Callback = keepSetting("aimHead", "Aim head"),
	})

	local blasterSection = combat:Section({ Title = "Blaster", Icon = "zap", Side = "Right" })
	blasterSection:Slider({
		Title = "Firerate",
		Min = 1,
		Max = 20,
		Default = preferences.fireRate,
		Suffix = "x",
		Live = false,
		Flag = "fireRate",
		Callback = function(value)
			preferences.fireRate = value
			session.savePreferences()
			persistConfig()
		end,
	})

	local extras = combat:Section({ Title = "Visuals", Icon = "eye" })
	local circleToggle = extras:Toggle({
		Title = "FOV circle",
		Default = preferences.showCircle,
		Flag = "showCircle",
		Callback = keepSetting("showCircle", "FOV circle"),
	})
	if not fovCircle then
		circleToggle:Lock("Drawing is unavailable", "eye-off")
	end
	extras:Toggle({
		Title = "Snap projectile",
		Default = preferences.snapProjectile,
		Flag = "snapProjectile",
		Callback = keepSetting("snapProjectile", "Snap projectile"),
	})

	window:QuickBar({ Items = { silentAim } })
	local settings = window:SettingsTab()
	settings:Toggle({
		Title = "Lock Cursor To UI",
		Info = "Locks your mouse on the UI while the menu is open.",
		Default = preferences.lockCursor,
		Flag = "lockCursor",
		Callback = function(on)
			preferences.lockCursor = on
			session.savePreferences()
			persistConfig()
			applyCursorLock()
			notifyToggle("Lock Cursor To UI", on)
		end,
	})
	window:LoadAutoload()
	local armed = silentAim:Get()
	if type(armed) == "boolean" then
		setArmed(armed)
		preferences.silentAim = armed
	end
	task.defer(function()
		announceToggles = true
		persistConfig()
	end)
	return true
end

if not startHub() then
	notifyMissingCapabilities()
	session.unload()
	return
end
