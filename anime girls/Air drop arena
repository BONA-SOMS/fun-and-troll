local function resolve(parent: Instance, path: { string }, timeout: number): Instance?
	local node = parent
	for _, name in path do
		local child = node:WaitForChild(name, timeout)
		if not child then
			return nil
		end
		node = child
	end
	return node
end

local function acceptSetting(key: string, value: any): boolean
	local default = preferences[key]
	if type(default) ~= type(value) then
		return false
	end
	local field = SETTINGS_FIELDS[key]
	if not field then
		return false
	end
	if type(value) == "number" then
		if value ~= value or math.abs(value) == math.huge then
			return false
		end
		if field.min ~= nil and value < field.min then
			return false
		end
		if field.max ~= nil and value > field.max then
			return false
		end
	end
	return true
end

local settingsStatus = "unavailable"
local settingsProblem = "Settings storage is unavailable"
do
	local readfile, writefile, isfile, isfolder, makefolder =
		readfile, writefile, isfile, isfolder, makefolder
	local persistent = isfile
		and writefile
		and readfile
		and isfolder
		and makefolder
		and gameScope > 0
	if persistent then
		local path = `{SETTINGS_FOLDER}/{gameScope}.json`
		local loaded, body = pcall(function()
			return if isfile(path) then readfile(path) else nil
		end)
		if not loaded then
			settingsStatus, settingsProblem = "unsaved", "Settings file could not be read"
		elseif body ~= nil then
			local decoded, stored = pcall(HttpService.JSONDecode, HttpService, body)
			if
				decoded
				and type(stored) == "table"
				and type(stored.values) == "table"
				and stored.version == SETTINGS_VERSION
				and (stored.gameId == nil or stored.gameId == gameScope)
			then
				for key in preferences do
					if acceptSetting(key, stored.values[key]) then
						preferences[key] = stored.values[key]
					end
				end
				settingsStatus, settingsProblem = "saved", nil
			else
				settingsStatus, settingsProblem = "unsaved", "Settings file is malformed"
			end
		else
			settingsStatus, settingsProblem = "ready", nil
		end
	end

	function session.savePreferences(): boolean
		if not persistent then
			return false
		end
		local snapshot = {}
		for key, value in preferences do
			if not acceptSetting(key, value) then
				settingsStatus, settingsProblem = "unsaved", `Invalid settings value: {key}`
				report(settingsProblem)
				return false
			end
			snapshot[key] = value
		end
		local written = pcall(function()
			if not isfolder(SETTINGS_FOLDER) then
				makefolder(SETTINGS_FOLDER)
			end
			writefile(`{SETTINGS_FOLDER}/{gameScope}.json`, HttpService:JSONEncode({
				version = SETTINGS_VERSION,
				gameId = gameScope,
				values = snapshot,
			}))
		end)
		if written then
			settingsStatus, settingsProblem = "saved", nil
		else
			settingsStatus, settingsProblem = "unsaved", "Settings file could not be saved"
			report(settingsProblem)
		end
		return written
	end
end

