local function unload()
	if not session.alive then
		return
	end
	session.alive = false
	session.on = false
	session.aimPosition = nil
	session.aimPart = nil
	for index = #hooked, 1, -1 do
		local record = hooked[index]
		if record.target and record.original then
			pcall(hookfunction, record.target, record.original)
		end
	end
	table.clear(hooked)
	table.clear(originals)
	root:clean()
	if rawequal(rawget(env, "silentAimSession"), session) then
		rawset(env, "silentAimSession", nil)
	end
end

