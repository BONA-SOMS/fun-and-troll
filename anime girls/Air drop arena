type Disposable = RBXScriptConnection | Instance | thread | (() -> ())
type CleanupBag = {
	items: { Disposable },
	closed: boolean,
	add: (self: CleanupBag, item: Disposable) -> Disposable,
	clean: (self: CleanupBag) -> (),
	guard: (self: CleanupBag, callback: (...any) -> ()) -> (...any) -> (),
}

