local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- WOOD KATANA
task.spawn(function()
    while task.wait() do
        local Character = LocalPlayer.Character
        if Character then
            local Weapon = Character:WaitForChild("WoodKatana")
            Weapon:WaitForChild("WoodKatanaRemote"):FireServer()
        end
    end
end)

