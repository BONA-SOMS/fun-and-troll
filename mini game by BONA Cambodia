local mcCards, mcOpen = {}, {}
local mcLvl, mcMoves, mcMatched, mcPairs, mcBusy, mcWon, mcToken, mcDelay = 1, 0, 0, 2, false, false, 0, 0.9

local function mcUpdate()
	if mcWon then
		mcStatus.Text = ("Level %d complete in %d moves!%s"):format(mcLvl, mcMoves, mcLvl < MC_COUNT and " Tap Next" or "")
	else
		mcStatus.Text = ("Level %d/%d - Pairs %d/%d - Moves %d"):format(mcLvl, MC_COUNT, mcMatched, mcPairs, mcMoves)
	end
end

local function bestDims(total)
	local bc, br, bs = 2, math.ceil(total / 2), 1e9
	for cols = 2, 8 do
		local rows = math.ceil(total / cols)
		local blanks = cols * rows - total
		if blanks < cols then
			local score = blanks * 3 + math.abs(cols - rows)
			if score < bs then bc, br, bs = cols, rows, score end
		end
	end
	return bc, br
end

local function flipCard(cd, up)
	cd.up = up
	sfx.flip()
	local t1 = TweenService:Create(cd.card, TweenInfo.new(0.09, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{ Size = UDim2.fromOffset(0, cd.size) })
	t1:Play()
	task.wait(0.1)
	cd.face.Visible = up
	cd.back.Visible = not up
	TweenService:Create(cd.card, TweenInfo.new(0.09, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = UDim2.fromOffset(cd.size, cd.size) }):Play()
end

local function onCard(cd)
	if mcBusy or cd.up or cd.matched or mcWon then return end
	mcBusy = true
	local tk = mcToken
	flipCard(cd, true)
	task.wait(0.1)
	if tk ~= mcToken then return end
	mcOpen[#mcOpen + 1] = cd
	if #mcOpen == 2 then
		mcMoves += 1
		local a, b = mcOpen[1], mcOpen[2]
		mcOpen = {}
		if a.id == b.id then
			a.matched, b.matched = true, true
			sfx.match()
			mcMatched += 1
			for _, c in ipairs({ a, b }) do
				local st = Instance.new("UIStroke")
				st.Color = Color3.fromRGB(60, 200, 90)
				st.Thickness = 3
				st.Parent = c.card
				TweenService:Create(c.card, TweenInfo.new(0.14, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
					{ Size = UDim2.fromOffset(c.size + 8, c.size + 8) }):Play()
			end
			task.wait(0.16)
			if tk ~= mcToken then return end
			for _, c in ipairs({ a, b }) do
				TweenService:Create(c.card, TweenInfo.new(0.12), { Size = UDim2.fromOffset(c.size, c.size) }):Play()
			end
			if mcMatched == mcPairs then
				mcWon = true
				mcUpdate()
				celebrate(mcLvl < MC_COUNT and "Level complete!" or "All levels complete!")
				mcBusy = false
				return
			end
		else
			sfx.bad()
			task.wait(mcDelay)
			if tk ~= mcToken then return end
			task.spawn(function() flipCard(a, false) end)
			flipCard(b, false)
			task.wait(0.1)
			if tk ~= mcToken then return end
		end
	end
	mcUpdate()
	mcBusy = false
end

local function loadMC(idx)
	mcToken += 1
	mcLvl, mcMoves, mcMatched, mcOpen, mcBusy, mcWon = idx, 0, 0, {}, false, false
	for _, c in ipairs(mcCards) do c.btn:Destroy() end
	mcCards = {}
	mcPairs = 2 + math.floor((idx - 1) * 17 / 120)
	mcDelay = math.max(0.45, 0.95 - idx * 0.004)
	local rng = Random.new(idx * 7919 + 3)
	local pool = {}
	for i, v in ipairs(ICONS) do pool[i] = v end
	for i = #pool, 2, -1 do
		local j = rng:NextInteger(1, i)
		pool[i], pool[j] = pool[j], pool[i]
	end
	local ids = {}
	for i = 1, mcPairs do
		ids[#ids + 1] = pool[i]
		ids[#ids + 1] = pool[i]
	end
	for i = #ids, 2, -1 do
		local j = rng:NextInteger(1, i)
		ids[i], ids[j] = ids[j], ids[i]
	end
	local total = #ids
	local cols, rows = bestDims(total)
	local cell = math.floor(math.min(S / cols, S / rows))
	local csz = cell - 8
	local startY = math.floor((S - rows * cell) / 2)
	for k, id in ipairs(ids) do
		local r = math.floor((k - 1) / cols)
		local c = (k - 1) % cols
		local rowCount = (r == rows - 1) and (total - cols * (rows - 1)) or cols
		local sx = math.floor((S - rowCount * cell) / 2)
		local btn = Instance.new("TextButton")
		btn.Text = ""
		btn.AutoButtonColor = false
		btn.BackgroundTransparency = 1
		btn.BorderSizePixel = 0
		btn.Position = UDim2.fromOffset(sx + c * cell, startY + r * cell)
		btn.Size = UDim2.fromOffset(cell, cell)
		btn.Parent = mcBoard
		local border = (rng:NextInteger(0, 1) == 0) and ORANGE or PURPLE
		local card, face, back = buildCard(btn, csz, border, id, false)
		card.Position = UDim2.fromScale(0.5, 0.5)
		local cd = { id = id, btn = btn, card = card, face = face, back = back, size = csz, up = false, matched = false }
		btn.Activated:Connect(function() onCard(cd) end)
		mcCards[#mcCards + 1] = cd
	end
	mcUpdate()
end

return { page = mcPage, load = loadMC, lvl = function() return mcLvl end, count = MC_COUNT, build = buildCard }
end)()

