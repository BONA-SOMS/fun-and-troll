local function askPromo(ms)
	promoMoves = ms
	promoting = true
	for _, e in ipairs(promoBtns) do
		drawPiece(e.holder, playerColor * e.pt)
	end
	promoFrame.Visible = true
end

function onSquare(i)
	if busy or gameOver or promoting or state.turn ~= playerColor then return end
	local p = state.b[i]
	if selected and targets[i] then
		local ms = targets[i]
		if #ms > 1 then askPromo(ms) else playMove(ms[1]) end
		return
	end
	if p ~= 0 and (p > 0) == (playerColor > 0) then
		selected = i
		targets = {}
		for _, m in ipairs(legalNow) do
			if m.f == i then
				targets[m.t] = targets[m.t] or {}
				table.insert(targets[m.t], m)
			end
		end
	else
		selected, targets = nil, {}
	end
	refresh()
end

function afterMove()
	legalNow = legal(state)
	refresh()
	local chk = inCheck(state, state.turn)
	if #legalNow == 0 then
		gameOver = true
		if chk then
			if -state.turn == playerColor then
				setStatus("Checkmate - you win!")
				celebrate("You win!")
			else
				setStatus("Checkmate - Bot wins")
			end
		else
			setStatus("Stalemate - draw")
		end
	elseif state.half >= 100 then
		gameOver = true
		setStatus("Draw (50-move rule)")
	elseif insufficient(state.b) then
		gameOver = true
		setStatus("Draw (not enough material)")
	elseif state.turn == playerColor then
		setStatus(chk and "Your turn - CHECK!" or "Your turn")
	else
		setStatus("Bot is thinking...")
		botTurn()
	end
end

function botTurn()
	busy = true
	local id = gameId
	task.spawn(function()
		task.wait(0.25)
		local snap = copyState(state)
		local lv = LEVELS[level]
		local m = bestMove(snap, lv.depth, lv.noise)
		if id ~= gameId or not m then return end
		busy = false
		playMove(m)
	end)
end

function newGame()
	gameId += 1
	state = newState()
	selected, targets, lastMove = nil, {}, nil
	gameOver, busy, promoting = false, false, false
	promoFrame.Visible = false
	layout()
	legalNow = legal(state)
	refresh()
	if playerColor == 1 then
		setStatus("Your turn (White)")
	else
		setStatus("Bot is thinking...")
		botTurn()
	end
end

