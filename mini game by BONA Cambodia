local function layout()
	for i = 1, 64 do
		local r, c = (i - 1) // 8, (i - 1) % 8
		local vr, vc = r, c
		if playerColor == -1 then vr, vc = 7 - r, 7 - c end
		local sq = squares[i]
		local light = (r + c) % 2 == 0
		sq.btn.Position = UDim2.fromScale(vc * 0.125, vr * 0.125)
		sq.btn.BackgroundColor3 = light and LIGHT or DARK
		local tcol = light and DARK or LIGHT
		sq.rank.TextColor3 = tcol
		sq.file.TextColor3 = tcol
		sq.rank.Text = (vc == 0) and tostring(8 - r) or ""
		sq.file.Text = (vr == 7) and string.char(97 + c) or ""
	end
end

