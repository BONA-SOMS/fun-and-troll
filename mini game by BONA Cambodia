local SN_COUNT = #SNL
local D4 = { { -1, 0 }, { 1, 0 }, { 0, -1 }, { 0, 1 } }

local snPage = Instance.new("Frame")
snPage.BackgroundTransparency = 1
snPage.Size = UDim2.fromScale(1, 1)
snPage.Visible = false
snPage.Parent = main

label(snPage, "SNAKE", UDim2.fromOffset(S - 150, 22), UDim2.fromOffset(PAD, 6), 17)
local snStatus = label(snPage, "", UDim2.fromOffset(S, 20), UDim2.fromOffset(PAD, 28), 13,
	Color3.fromRGB(190, 190, 185), Enum.Font.Gotham)

local snBoard = Instance.new("Frame")
snBoard.BackgroundColor3 = Color3.fromRGB(134, 205, 242)
snBoard.BorderSizePixel = 0
snBoard.ClipsDescendants = true
snBoard.Parent = snPage
Instance.new("UICorner", snBoard).CornerRadius = UDim.new(0, 10)

local snCatch = Instance.new("TextButton")
snCatch.BackgroundTransparency = 1
snCatch.Text = ""
snCatch.Size = UDim2.fromScale(1, 1)
snCatch.ZIndex = 30
snCatch.Parent = snBoard

local snN, snCell, snLvl = 5, 40, 1
local snWall, snSpike, snApples, snApplesLeft, snExit, snExitObj = {}, {}, {}, 0, nil, nil
local snBody, snHist, snMoves = {}, {}, 0
local snDead, snWon, snMsg = false, false, ""
local snStatic, snDyn, snAppleObj = {}, {}, {}

local function key(r, c) return r * 100 + c end

local function px(parent, x, y, w, h, col, round, rot, stroke)
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	f.BackgroundColor3 = col
	f.Position = UDim2.fromOffset(x, y)
	f.Size = UDim2.fromOffset(w, h)
	if rot then f.Rotation = rot end
	if round then Instance.new("UICorner", f).CornerRadius = UDim.new(round, 0) end
	if stroke then
		local st = Instance.new("UIStroke")
		st.Color = stroke
		st.Thickness = 2
		st.Parent = f
	end
	f.Parent = parent
	return f
end

local function snUpdate()
	if snWon then
		snStatus.Text = ("Level %d complete in %d moves!%s"):format(snLvl, snMoves, snLvl < SN_COUNT and " Tap Next" or "")
	elseif snDead then
		snStatus.Text = snMsg
	else
		snStatus.Text = ("Level %d/%d - Apples left %d - Moves %d"):format(snLvl, SN_COUNT, snApplesLeft, snMoves)
	end
end

local function snBuild(rows)
	for _, o in ipairs(snStatic) do o:Destroy() end
	for _, o in ipairs(snDyn) do o:Destroy() end
	snStatic, snDyn, snAppleObj = {}, {}, {}
	snN = #rows
	snCell = math.floor(S / snN)
	snBoard.Size = UDim2.fromOffset(snCell * snN, snCell * snN)
	snBoard.Position = UDim2.fromOffset(PAD + math.floor((S - snCell * snN) / 2), 54)
	snWall, snSpike, snApples, snApplesLeft, snExit, snExitObj = {}, {}, {}, 0, nil, nil
	local segs = {}
	local cell = snCell
	local function add(o) snStatic[#snStatic + 1] = o return o end
	for r = 1, snN do
		for c = 1, snN do
			local ch = rows[r]:sub(c, c)
			local x, y = (c - 1) * cell, (r - 1) * cell
			local bg = add(px(snBoard, x, y, cell, cell,
				((r + c) % 2 == 0) and Color3.fromRGB(142, 209, 245) or Color3.fromRGB(128, 200, 240)))
			if ch == "#" then
				snWall[key(r, c)] = true
				add(px(snBoard, x + 1, y + 1, cell - 2, cell - 2, Color3.fromRGB(150, 94, 52), 0.12, nil, Color3.fromRGB(92, 56, 30)))
				add(px(snBoard, x + 2, y + 2, cell - 4, math.floor(cell * 0.26), Color3.fromRGB(108, 184, 64), 0.3))
			elseif ch == "X" then
				snSpike[key(r, c)] = true
				local d = math.floor(cell * 0.8)
				local cx, cy = x + cell / 2, y + cell / 2
				for _, ang in ipairs({ 0, 45, 90, 135 }) do
					add(px(snBoard, cx - d / 2, cy - d * 0.08, d, math.floor(d * 0.16), Color3.fromRGB(150, 154, 166), 0.5, ang))
				end
				add(px(snBoard, cx - d * 0.34, cy - d * 0.34, d * 0.68, d * 0.68, Color3.fromRGB(184, 188, 200), 0.5, nil, Color3.fromRGB(80, 84, 96)))
				add(px(snBoard, cx - d * 0.12, cy - d * 0.12, d * 0.24, d * 0.24, Color3.fromRGB(96, 100, 112), 0.5))
			elseif ch == "A" then
				snApples[key(r, c)] = true
				snApplesLeft += 1
				local g = add(px(snBoard, x, y, cell, cell, Color3.new(1, 1, 1)))
				g.BackgroundTransparency = 1
				local d = math.floor(cell * 0.62)
				px(g, (cell - d) / 2, (cell - d) / 2 + cell * 0.04, d, d, Color3.fromRGB(226, 50, 50), 0.5, nil, Color3.fromRGB(140, 20, 20))
				px(g, cell * 0.5 - 1, cell * 0.12, 3, cell * 0.16, Color3.fromRGB(96, 60, 30), 0.5)
				px(g, cell * 0.52, cell * 0.14, cell * 0.2, cell * 0.1, Color3.fromRGB(80, 190, 60), 0.5, -25)
				px(g, cell * 0.3, cell * 0.36, cell * 0.12, cell * 0.12, Color3.new(1, 1, 1), 0.5).BackgroundTransparency = 0.35
				snAppleObj[key(r, c)] = g
			elseif ch == "E" then
				snExit = { r = r, c = c }
				local d = math.floor(cell * 0.84)
				local outer = add(px(snBoard, (c - 1) * cell + (cell - d) / 2, (r - 1) * cell + (cell - d) / 2, d, d,
					Color3.fromRGB(50, 50, 58), 0.5, nil, Color3.fromRGB(90, 90, 100)))
				add(px(snBoard, (c - 1) * cell + cell * 0.3, (r - 1) * cell + cell * 0.3, cell * 0.4, cell * 0.4, Color3.fromRGB(8, 4, 14), 0.5))
				snExitObj = { outer = outer, stroke = outer:FindFirstChildOfClass("UIStroke") }
			elseif ch:match("%d") then
				segs[tonumber(ch)] = { r = r, c = c }
			end
		end
	end
	snBody = {}
	for i = 1, #segs do snBody[i] = segs[i] end
end

local function snRender()
	for _, o in ipairs(snDyn) do o:Destroy() end
	snDyn = {}
	for k, g in pairs(snAppleObj) do g.Visible = snApples[k] ~= nil end
	if snExitObj then
		local open = snApplesLeft == 0
		snExitObj.stroke.Color = open and Color3.fromRGB(206, 150, 255) or Color3.fromRGB(90, 90, 100)
		snExitObj.outer.BackgroundColor3 = open and Color3.fromRGB(60, 24, 110) or Color3.fromRGB(50, 50, 58)
	end
	local t = math.floor(snCell * 0.74)
	local function ctr(s) return (s.c - 0.5) * snCell, (s.r - 0.5) * snCell end
	for i = #snBody, 1, -1 do
		local a = snBody[i]
		local nxt = snBody[i + 1]
		local x1, y1 = ctr(a)
		local x2, y2 = x1, y1
		if nxt then x2, y2 = ctr(nxt) end
		local col = (i == 1) and Color3.fromRGB(124, 220, 80) or Color3.fromRGB(88, 192, 62)
		local f = px(snBoard, math.min(x1, x2) - t / 2, math.min(y1, y2) - t / 2,
			math.abs(x1 - x2) + t, math.abs(y1 - y2) + t, col, 0.4, nil, Color3.fromRGB(36, 112, 28))
		f.ZIndex = 5
		snDyn[#snDyn + 1] = f
	end
	-- eyes on the head
	local h = snBody[1]
	local fr, fc = 0, 1
	if snBody[2] then fr, fc = h.r - snBody[2].r, h.c - snBody[2].c end
	local hx, hy = ctr(h)
	for _, side in ipairs({ -1, 1 }) do
		local ex = hx + fc * t * 0.14 + (-fr) * side * t * 0.22
		local ey = hy + fr * t * 0.14 + fc * side * t * 0.22
		local ed = t * 0.3
		local e = px(snBoard, ex - ed / 2, ey - ed / 2, ed, ed, Color3.new(1, 1, 1), 0.5, nil, Color3.fromRGB(36, 112, 28))
		e.ZIndex = 6
		local pd = ed * 0.5
		local p = px(snBoard, ex + fc * ed * 0.12 - pd / 2, ey + fr * ed * 0.12 - pd / 2, pd, pd, Color3.fromRGB(20, 20, 24), 0.5)
		p.ZIndex = 7
		snDyn[#snDyn + 1] = e
		snDyn[#snDyn + 1] = p
	end
end

local snBusy, snToken = false, 0

local function solidAt(r, c)
	local k = key(r, c)
	if snWall[k] or snApples[k] then return true end
	if snExit and r == snExit.r and c == snExit.c and snApplesLeft > 0 then return true end
	return false
end

local function supported()
	for _, s in ipairs(snBody) do
		if solidAt(s.r + 1, s.c) then return true end
	end
	return false
end

local function canStep(dr, dc)
	local h = snBody[1]
	local nr, nc = h.r + dr, h.c + dc
	if nr < 1 or nr > snN or nc < 1 or nc > snN then return false, "wall" end
	local k = key(nr, nc)
	if snWall[k] then return false, "wall" end
	if snSpike[k] then return false, "saw" end
	if snExit and nr == snExit.r and nc == snExit.c and snApplesLeft > 0 then return false, "wall" end
	local eat = snApples[k] ~= nil
	local limit = eat and #snBody or (#snBody - 1)
	for i = 1, limit do
		if snBody[i].r == nr and snBody[i].c == nc then return false, "wall" end
	end
	return true, eat and "eat" or "move"
end

local function hasMove()
	for _, d in ipairs(D4) do
		if canStep(d[1], d[2]) then return true end
	end
	return false
end

local function die(msg, title, sub)
	snDead = true
	snMsg = msg
	snUpdate()
	lose(title, sub)
end

local function win()
	snWon = true
	snUpdate()
	celebrate(snLvl < SN_COUNT and "Level complete!" or "All levels complete!")
end

local function atExit()
	local h = snBody[1]
	return snExit and h.r == snExit.r and h.c == snExit.c and snApplesLeft == 0
end

-- gravity: fall one row at a time until something holds the snake up
local function settle(tk)
	while true do
		if tk ~= snToken then return "cancel" end
		if supported() then return "ok" end
		local out, hitSaw = false, false
		for _, s in ipairs(snBody) do
			s.r += 1
			if s.r > snN then out = true end
			if snSpike[key(s.r, s.c)] then hitSaw = true end
		end
		snRender()
		task.wait(0.09)
		if tk ~= snToken then return "cancel" end
		if out then return "fell" end
		if hitSaw then return "saw" end
		if atExit() then return "win" end
	end
end

local function afterMove()
	if not hasMove() then
		die("Stuck! Tap Undo or Restart", "Stuck!", "Don't get stuck - tap Undo")
	else
		snUpdate()
	end
end

local function move(dr, dc)
	if snBusy or snWon or snDead then return end
	local ok, kind = canStep(dr, dc)
	if not ok then
		if kind == "saw" then
			die("Ouch! A saw got you - Undo or Restart", "You lost", "The saw got you!")
		else
			sfx.bad()
		end
		return
	end
	local snap = { body = {}, apples = {}, left = snApplesLeft }
	for i, s in ipairs(snBody) do snap.body[i] = { r = s.r, c = s.c } end
	for k in pairs(snApples) do snap.apples[k] = true end
	snHist[#snHist + 1] = snap
	local h = snBody[1]
	local nr, nc = h.r + dr, h.c + dc
	table.insert(snBody, 1, { r = nr, c = nc })
	if kind == "eat" then
		snApples[key(nr, nc)] = nil
		snApplesLeft -= 1
		sfx.eat()
	else
		table.remove(snBody)
		sfx.move()
	end
	snMoves += 1
	snRender()
	if atExit() then
		win()
	elseif supported() then
		afterMove()
	else
		snBusy = true
		local tk = snToken
		task.spawn(function()
			local res = settle(tk)
			if res == "cancel" or tk ~= snToken then return end
			snBusy = false
			if res == "win" then
				win()
			elseif res == "fell" then
				die("You fell! Tap Undo or Restart", "You fell!", "Mind the edge")
			elseif res == "saw" then
				die("Ouch! A saw got you - Undo or Restart", "You lost", "The saw got you!")
			else
				sfx.drop()
				afterMove()
			end
		end)
	end
end

local function undo()
	if snBusy or #snHist == 0 then return end
	local snap = table.remove(snHist)
	snBody = snap.body
	snApples = snap.apples
	snApplesLeft = snap.left
	snMoves = math.max(0, snMoves - 1)
	snDead, snWon = false, false
	sfx.tap()
	snRender()
	snUpdate()
end

local function load(idx)
	snToken += 1
	snBusy = false
	snLvl = idx
	snMoves, snHist, snDead, snWon = 0, {}, false, false
	snBuild(SNL[idx].rows)
	snRender()
	snUpdate()
end

-- keyboard (arrows / WASD)
UIS.InputBegan:Connect(function(input, processed)
	if processed or not snPage.Visible then return end
	local k = input.KeyCode
	if k == Enum.KeyCode.Up or k == Enum.KeyCode.W then move(-1, 0)
	elseif k == Enum.KeyCode.Down or k == Enum.KeyCode.S then move(1, 0)
	elseif k == Enum.KeyCode.Left or k == Enum.KeyCode.A then move(0, -1)
	elseif k == Enum.KeyCode.Right or k == Enum.KeyCode.D then move(0, 1) end
end)

-- swipe on the board
local snDrag
snCatch.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		snDrag = Vector2.new(input.Position.X, input.Position.Y)
	end
end)
UIS.InputEnded:Connect(function(input)
	if not snDrag then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		local d = Vector2.new(input.Position.X, input.Position.Y) - snDrag
		snDrag = nil
		if d.Magnitude >= 16 then
			if math.abs(d.X) > math.abs(d.Y) then move(0, d.X > 0 and 1 or -1) else move(d.Y > 0 and 1 or -1, 0) end
		end
	end
end)

return { page = snPage, load = load, lvl = function() return snLvl end, count = SN_COUNT, move = move, undo = undo }
end)()

