local function layout()
	for i = 1, 64 do
		local r, c = (i - 1) // 8, (i - 1) % 8
		local vr, vc = r, c
		if playerColor == -1 then vr, vc = 7 - r, 7 - c end
		local sq = squares[i]
		local light = (r + c) % 2 == 0
		sq.btn.Position = UDim2.fromScale(vc * 0.125, vr * 0.125)
		sq.btn.BackgroundColor3 = light and LIGHT or DARK
		local tcol = light and DARK or LIGHT
		sq.rank.TextColor3 = tcol
		sq.file.TextColor3 = tcol
		sq.rank.Text = (vc == 0) and tostring(8 - r) or ""
		sq.file.Text = (vr == 7) and string.char(97 + c) or ""
	end
end

local function setStatus(t) status.Text = t end

local function refresh()
	local b = state.b
	local checkSq = nil
	if not gameOver or true then
		if inCheck(state, state.turn) then checkSq = kingSq(b, state.turn) end
	end
	for i = 1, 64 do
		local sq = squares[i]
		local p = b[i]
		if sq.code ~= p then
			sq.code = p
			drawPiece(sq.piece, p)
		end

		if selected == i then
			sq.hl.BackgroundColor3 = YELLOW; sq.hl.BackgroundTransparency = 0.25; sq.hl.Visible = true
		elseif checkSq == i then
			sq.hl.BackgroundColor3 = RED; sq.hl.BackgroundTransparency = 0.25; sq.hl.Visible = true
		elseif lastMove and (lastMove.f == i or lastMove.t == i) then
			sq.hl.BackgroundColor3 = YELLOW; sq.hl.BackgroundTransparency = 0.6; sq.hl.Visible = true
		else
			sq.hl.Visible = false
		end

		if targets[i] then
			sq.dot.Visible = true
			if p ~= 0 then
				sq.dot.Size = UDim2.fromScale(0.88, 0.88)
				sq.dot.BackgroundTransparency = 1
				sq.stroke.Enabled = true
			else
				sq.dot.Size = UDim2.fromScale(0.3, 0.3)
				sq.dot.BackgroundTransparency = 0.75
				sq.stroke.Enabled = false
			end
		else
			sq.dot.Visible = false
		end
	end
end

