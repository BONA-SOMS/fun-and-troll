local TweenService = game:GetService("TweenService")
local BITS = { N = 1, E = 2, S = 4, W = 8 }
local DIRS = { { -1, 0, 1, 4 }, { 0, 1, 2, 8 }, { 1, 0, 4, 1 }, { 0, -1, 8, 2 } } -- dr, dc, bit, opposite bit

-- tokens: .=blank  -=horizontal  |=vertical  NE/SE/SW/NW=curve  sX=start(ball) eX=end  _=empty slot  !=fixed (metal)
-- each level is the SOLVED layout, it gets shuffled automatically (so it is always solvable)
local SLEVELS = {
	{ "sE! - SW", ". . |", "_ . eN!" },
	{ "sE! - SW .", "NE . NE SW", ". - . |", "_ . . eN!" },
	{ "eS! . .! . .", "| - . . .", "NE SW NW . .", ". . NE - sW!", "_ . . . ." },
	{ "sS! . . . .", "| NW .! . .", "NE - SW . .", ".! . NE - SW", "_ . - . eN!" },
	{ "eS! . . .", "| - .! .", "NE SW NW .", "_ NE - sW!" },
}

local function parseTok(tok)
	local fixed = false
	if tok:sub(-1) == "!" then fixed = true; tok = tok:sub(1, -2) end
	if tok == "_" then return false end
	local t = { fixed = fixed, kind = "track", mask = 0 }
	if tok == "." then
		t.kind = "blank"
	elseif tok == "-" then
		t.mask = 10
	elseif tok == "|" then
		t.mask = 5
	elseif tok:sub(1, 1) == "s" then
		t.kind = "start"; t.mask = BITS[tok:sub(2, 2)]; t.fixed = true
	elseif tok:sub(1, 1) == "e" then
		t.kind = "end"; t.mask = BITS[tok:sub(2, 2)]; t.fixed = true
	else
		for ch in tok:gmatch(".") do t.mask += BITS[ch] end
	end
	return t
end

local function circle(parent, x, y, d, col, strokeCol)
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	f.BackgroundColor3 = col
	f.Position = UDim2.fromScale(x, y)
	f.Size = UDim2.fromScale(d, d)
	Instance.new("UICorner", f).CornerRadius = UDim.new(1, 0)
	if strokeCol then
		local st = Instance.new("UIStroke")
		st.Color = strokeCol
		st.Thickness = 1.5
		st.Parent = f
	end
	f.Parent = parent
	return f
end

local function drawGroove(body, mask)
	for layer = 1, 2 do
		local thick = layer == 1 and 0.36 or 0.24
		local col = layer == 1 and Color3.fromRGB(72, 32, 16) or Color3.fromRGB(132, 70, 40)
		local half = thick / 2
		local function seg(x, y, w, h, round)
			local f = Instance.new("Frame")
			f.BorderSizePixel = 0
			f.BackgroundColor3 = col
			f.Position = UDim2.fromScale(x, y)
			f.Size = UDim2.fromScale(w, h)
			if round then Instance.new("UICorner", f).CornerRadius = UDim.new(1, 0) end
			f.Parent = body
		end
		seg(0.5 - half, 0.5 - half, thick, thick, true)
		if bit32.band(mask, 1) ~= 0 then seg(0.5 - half, 0, thick, 0.5) end
		if bit32.band(mask, 2) ~= 0 then seg(0.5, 0.5 - half, 0.5, thick) end
		if bit32.band(mask, 4) ~= 0 then seg(0.5 - half, 0.5, thick, 0.5) end
		if bit32.band(mask, 8) ~= 0 then seg(0, 0.5 - half, 0.5, thick) end
	end
end

local function buildTile(parent, t)
	local body = Instance.new("Frame")
	body.AnchorPoint = Vector2.new(0.5, 0.5)
