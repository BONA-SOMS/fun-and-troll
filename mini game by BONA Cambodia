function ssCanMove(p, dr, dc)
	local nr, nc = p.r + dr, p.c + dc
	if nr < 1 or nc < 1 or nr + p.h - 1 > 5 or nc + p.w - 1 > 4 then return false end
	for i = 0, p.h - 1 do
		for j = 0, p.w - 1 do
			local o = ssOcc[nr + i][nc + j]
			if o and o ~= p then return false end
		end
	end
	return true
end

function ssStep(p, dr, dc)
	if ssLocked or not ssCanMove(p, dr, dc) then return false end
	for i = 0, p.h - 1 do
		for j = 0, p.w - 1 do ssOcc[p.r + i][p.c + j] = false end
	end
	p.r += dr; p.c += dc
	for i = 0, p.h - 1 do
		for j = 0, p.w - 1 do ssOcc[p.r + i][p.c + j] = p end
	end
	TweenService:Create(p.btn, TweenInfo.new(0.1, Enum.EasingStyle.Quad),
		{ Position = UDim2.fromOffset((p.c - 1) * sCell, (p.r - 1) * sCell) }):Play()
	ssMoves += 1
	sfx.move()
	ssUpdate()
	if p.kind == "R" and p.r == 4 and p.c == 2 then
		ssLocked = true
		local par = SSL[ssLvl].par
		local txt = ("Solved in %d moves"):format(ssMoves)
		if ssMoves <= par then txt ..= " - perfect!" end
		if ssLvl < #SSL then txt ..= " Tap Next" end
		ssStatus.Text = txt
		celebrate(ssLvl < #SSL and "Level complete!" or "All levels complete!")
	end
	return true
end

function ssSelect(p)
	if ssSel then
		ssSel.stroke.Color = BLOCKC[ssSel.kind][3]
		ssSel.stroke.Thickness = 2
	end
	ssSel = p
	if p then
		p.stroke.Color = Color3.new(1, 1, 1)
		p.stroke.Thickness = 4
	end
end

-- swipe a block to move it (keep dragging to move further)
UIS.InputChanged:Connect(function(input)
	if not ssDrag then return end
	if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
	local pos = Vector2.new(input.Position.X, input.Position.Y)
	local d = pos - ssDrag.last
	if math.abs(d.X) >= sCell * 0.4 or math.abs(d.Y) >= sCell * 0.4 then
		if math.abs(d.X) > math.abs(d.Y) then
			ssStep(ssDrag.p, 0, d.X > 0 and 1 or -1)
		else
			ssStep(ssDrag.p, d.Y > 0 and 1 or -1, 0)
		end
		ssDrag.last = pos
		ssDrag.moved = true
	end
end)
UIS.InputEnded:Connect(function(input)
	if not ssDrag then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		if not ssDrag.moved then ssSelect(ssDrag.p) end
		ssDrag = nil
	end
end)

local function loadSS(idx)
	ssLvl, ssMoves, ssLocked, ssSel, ssDrag = idx, 0, false, nil, nil
	for _, p in ipairs(ssPieces) do p.btn:Destroy() end
	ssPieces = {}
	ssOcc = {}
	for r = 1, 5 do ssOcc[r] = { false, false, false, false } end

	local groups, order = {}, {}
	for r, row in ipairs(SSL[idx].rows) do
		for c = 1, 4 do
			local ch = row:sub(c, c)
			if ch ~= "." then
				local g = groups[ch]
				if not g then
					groups[ch] = { r1 = r, c1 = c, r2 = r, c2 = c }
					order[#order + 1] = ch
				else
					g.r2 = math.max(g.r2, r)
					g.c2 = math.max(g.c2, c)
				end
			end
		end
	end
	for _, ch in ipairs(order) do
		local g = groups[ch]
		local p = { r = g.r1, c = g.c1, w = g.c2 - g.c1 + 1, h = g.r2 - g.r1 + 1 }
		if p.w == 2 and p.h == 2 then p.kind = "R"
		elseif p.w == 1 and p.h == 1 then p.kind = "Y"
		elseif p.w == 1 then p.kind = "V"
		else p.kind = "H" end
		local btn = Instance.new("TextButton")
		btn.Text = ""
		btn.AutoButtonColor = false
		btn.BackgroundTransparency = 1
		btn.BorderSizePixel = 0
		btn.Size = UDim2.fromOffset(p.w * sCell, p.h * sCell)
		btn.Position = UDim2.fromOffset((p.c - 1) * sCell, (p.r - 1) * sCell)
		btn.ZIndex = 3
		btn.Parent = ssBoard
		p.btn = btn
		local _body
		_body, p.stroke = buildBlock(btn, p.kind, sCell)
		for i = 0, p.h - 1 do
			for j = 0, p.w - 1 do ssOcc[p.r + i][p.c + j] = p end
		end
		btn.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				ssDrag = { p = p, last = Vector2.new(input.Position.X, input.Position.Y), moved = false }
			end
		end)
		ssPieces[#ssPieces + 1] = p
	end
	ssUpdate()
end

