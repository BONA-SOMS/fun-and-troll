local function parseTok(tok)
	local fixed = false
	if tok:sub(-1) == "!" then fixed = true; tok = tok:sub(1, -2) end
	if tok == "_" then return false end
	local t = { fixed = fixed, kind = "track", mask = 0 }
	if tok == "." then
		t.kind = "blank"
	elseif tok == "-" then
		t.mask = 10
	elseif tok == "|" then
		t.mask = 5
	elseif tok:sub(1, 1) == "s" then
		t.kind = "start"; t.mask = BITS[tok:sub(2, 2)]; t.fixed = true
	elseif tok:sub(1, 1) == "e" then
		t.kind = "end"; t.mask = BITS[tok:sub(2, 2)]; t.fixed = true
	else
		for ch in tok:gmatch(".") do t.mask += BITS[ch] end
	end
	return t
end

local function circle(parent, x, y, d, col, strokeCol)
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	f.BackgroundColor3 = col
	f.Position = UDim2.fromScale(x, y)
	f.Size = UDim2.fromScale(d, d)
	Instance.new("UICorner", f).CornerRadius = UDim.new(1, 0)
	if strokeCol then
		local st = Instance.new("UIStroke")
		st.Color = strokeCol
		st.Thickness = 1.5
		st.Parent = f
	end
	f.Parent = parent
	return f
end

local function drawGroove(body, mask)
	for layer = 1, 2 do
		local thick = layer == 1 and 0.36 or 0.24
		local col = layer == 1 and Color3.fromRGB(72, 32, 16) or Color3.fromRGB(132, 70, 40)
		local half = thick / 2
		local function seg(x, y, w, h, round)
			local f = Instance.new("Frame")
			f.BorderSizePixel = 0
			f.BackgroundColor3 = col
			f.Position = UDim2.fromScale(x, y)
			f.Size = UDim2.fromScale(w, h)
			if round then Instance.new("UICorner", f).CornerRadius = UDim.new(1, 0) end
			f.Parent = body
		end
		seg(0.5 - half, 0.5 - half, thick, thick, true)
		if bit32.band(mask, 1) ~= 0 then seg(0.5 - half, 0, thick, 0.5) end
		if bit32.band(mask, 2) ~= 0 then seg(0.5, 0.5 - half, 0.5, thick) end
		if bit32.band(mask, 4) ~= 0 then seg(0.5 - half, 0.5, thick, 0.5) end
		if bit32.band(mask, 8) ~= 0 then seg(0, 0.5 - half, 0.5, thick) end
	end
end

local function buildTile(parent, t)
	local body = Instance.new("Frame")
	body.AnchorPoint = Vector2.new(0.5, 0.5)
	body.Position = UDim2.fromScale(0.5, 0.5)
	body.Size = UDim2.fromScale(0.95, 0.95)
	body.BorderSizePixel = 0
	body.BackgroundColor3 = Color3.new(1, 1, 1)
	body.Parent = parent
	Instance.new("UICorner", body).CornerRadius = UDim.new(0.08, 0)
	local c1, c2, sc
	if t.kind == "end" then
		c1, c2, sc = Color3.fromRGB(224, 92, 72), Color3.fromRGB(188, 58, 44), Color3.fromRGB(110, 28, 20)
	elseif t.fixed then
		c1, c2, sc = Color3.fromRGB(176, 184, 194), Color3.fromRGB(138, 146, 156), Color3.fromRGB(80, 86, 94)
	else
		c1, c2, sc = Color3.fromRGB(238, 178, 110), Color3.fromRGB(204, 140, 78), Color3.fromRGB(136, 84, 40)
	end
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(c1, c2)
	g.Rotation = 90
	g.Parent = body
	local st = Instance.new("UIStroke")
	st.Color = sc
	st.Thickness = 2
	st.Parent = body

	if t.mask ~= 0 then drawGroove(body, t.mask) end
	if t.kind == "start" then
		circle(body, 0.31, 0.31, 0.38, Color3.fromRGB(60, 26, 12), Color3.fromRGB(40, 16, 8))
	elseif t.kind == "end" then
		circle(body, 0.3, 0.3, 0.4, Color3.fromRGB(18, 10, 6), Color3.fromRGB(70, 20, 14))
	end
	if t.fixed then
		for _, p in ipairs({ { 0.07, 0.07 }, { 0.83, 0.07 }, { 0.07, 0.83 }, { 0.83, 0.83 } }) do
			circle(body, p[1], p[2], 0.1, Color3.fromRGB(150, 156, 164), Color3.fromRGB(70, 74, 80))
		end
	end
	return body
end

