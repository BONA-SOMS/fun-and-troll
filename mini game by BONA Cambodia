local fwLvl, fwN, fwWord, fwGrid, fwCells = 1, 6, "FOX", {}, {}
local fwSel, fwDone, fwHint, fwFound, fwToken = nil, false, nil, {}, 0

local function paint()
	for r = 1, fwN do
		for c = 1, fwN do
			local b = fwCells[r][c]
			local col = ((r + c) % 2 == 0) and Color3.fromRGB(238, 242, 246) or Color3.fromRGB(228, 233, 238)
			if fwFound[r * 100 + c] then
				col = Color3.fromRGB(112, 214, 126)
			elseif fwSel and fwSel.r == r and fwSel.c == c then
				col = Color3.fromRGB(255, 222, 100)
			elseif fwHint and fwHint.r == r and fwHint.c == c then
				col = Color3.fromRGB(140, 190, 255)
			end
			b.BackgroundColor3 = col
		end
	end
end

local function fwTap(r, c)
	if fwDone then return end
	if not fwSel then
		fwSel = { r = r, c = c }
		fwHint = nil
		paint()
		return
	end
	if fwSel.r == r and fwSel.c == c then
		fwSel = nil
		paint()
		return
	end
	local L = #fwWord
	local dr, dc = r - fwSel.r, c - fwSel.c
	local straight = (dr == 0 or dc == 0 or math.abs(dr) == math.abs(dc))
	local ok = false
	local line = {}
	if straight and math.max(math.abs(dr), math.abs(dc)) + 1 == L then
		local sr, sc = sgn(dr), sgn(dc)
		local str = ""
		for i = 0, L - 1 do
			local rr, cc = fwSel.r + sr * i, fwSel.c + sc * i
			str ..= fwGrid[rr][cc]
			line[#line + 1] = { rr, cc }
		end
		ok = (str == fwWord or str:reverse() == fwWord)
	end
	if ok then
		fwDone = true
		for _, p in ipairs(line) do fwFound[p[1] * 100 + p[2]] = true end
		fwSel, fwHint = nil, nil
		paint()
		for _, p in ipairs(line) do
			local b = fwCells[p[1]][p[2]]
			local sz = b.Size
			TweenService:Create(b, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
				{ Size = UDim2.fromOffset(sz.X.Offset + 8, sz.Y.Offset + 8), Position = b.Position - UDim2.fromOffset(4, 4) }):Play()
		end
		fwStatus.Text = ('Found "%s"!%s'):format(fwWord, fwLvl < #FWL and " Tap Next" or "")
		celebrate(fwLvl < #FWL and "Word found!" or "All levels complete!")
	else
		local a, b = fwCells[fwSel.r][fwSel.c], fwCells[r][c]
		a.BackgroundColor3 = Color3.fromRGB(240, 120, 110)
		b.BackgroundColor3 = Color3.fromRGB(240, 120, 110)
		fwSel = nil
		fwStatus.Text = ('That is not "%s" - try again'):format(fwWord)
		local tk = fwToken
		task.delay(0.4, function()
			if tk == fwToken then paint() end
		end)
	end
end

local function loadFW(idx)
	fwToken += 1
	fwLvl, fwSel, fwDone, fwHint, fwFound = idx, nil, false, nil, {}
	for _, row in ipairs(fwCells) do
		for _, b in ipairs(row) do b:Destroy() end
	end
	fwCells = {}
	local lv = FWL[idx]
	fwN, fwWord = lv.n, lv.word
	fwGrid = genGrid(lv)
	local cell = math.floor(S / fwN)
	fwBoard.Size = UDim2.fromOffset(cell * fwN, cell * fwN)
	fwBoard.Position = UDim2.fromOffset(PAD + math.floor((S - cell * fwN) / 2), 54)
	for r = 1, fwN do
		fwCells[r] = {}
		for c = 1, fwN do
			local b = Instance.new("TextButton")
			b.AutoButtonColor = false
			b.BorderSizePixel = 0
			b.Position = UDim2.fromOffset((c - 1) * cell + 2, (r - 1) * cell + 2)
			b.Size = UDim2.fromOffset(cell - 4, cell - 4)
			b.Text = fwGrid[r][c]
			b.TextColor3 = Color3.fromRGB(52, 58, 66)
			b.Font = Enum.Font.GothamBlack
			b.TextSize = math.floor(cell * 0.5)
			b.Parent = fwBoard
			Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
			b.Activated:Connect(function() fwTap(r, c) end)
			fwCells[r][c] = b
		end
	end
	fwTitle.Text = ('FIND "%s"'):format(fwWord)
	fwStatus.Text = ("Level %d/%d - tap the first and last letter"):format(fwLvl, #FWL)
	paint()
end

local function fwShowHint()
	if fwDone then return end
	local occ = occurrences(fwGrid, fwN, fwWord)[1]
	if not occ then return end
	fwSel = nil
	fwHint = { r = occ.r, c = occ.c }
	paint()
	fwStatus.Text = "Hint: the word starts at the blue letter"
	local tk = fwToken
	task.delay(3, function()
		if tk == fwToken and not fwDone then
			fwHint = nil
			paint()
		end
	end)
end

return {
	page = fwPage, load = loadFW, hint = fwShowHint, count = #FWL,
	lvl = function() return fwLvl end,
}
end)()

