local function parseTok(tok)
	local fixed = false
	if tok:sub(-1) == "!" then fixed = true; tok = tok:sub(1, -2) end
	if tok == "_" then return false end
	local t = { fixed = fixed, kind = "track", mask = 0 }
	if tok == "." then
		t.kind = "blank"
	elseif tok == "-" then
		t.mask = 10
	elseif tok == "|" then
		t.mask = 5
	elseif tok:sub(1, 1) == "s" then
		t.kind = "start"; t.mask = BITS[tok:sub(2, 2)]; t.fixed = true
	elseif tok:sub(1, 1) == "e" then
		t.kind = "end"; t.mask = BITS[tok:sub(2, 2)]; t.fixed = true
	else
		for ch in tok:gmatch(".") do t.mask += BITS[ch] end
	end
	return t
end

local function circle(parent, x, y, d, col, strokeCol)
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	f.BackgroundColor3 = col
	f.Position = UDim2.fromScale(x, y)
	f.Size = UDim2.fromScale(d, d)
	Instance.new("UICorner", f).CornerRadius = UDim.new(1, 0)
	if strokeCol then
		local st = Instance.new("UIStroke")
		st.Color = strokeCol
		st.Thickness = 1.5
		st.Parent = f
	end
	f.Parent = parent
	return f
end

