	local body = Instance.new("Frame")
	body.AnchorPoint = Vector2.new(0.5, 0.5)
	body.Position = UDim2.fromScale(0.5, 0.5)
	body.Size = UDim2.new(1, -inset, 1, -inset)
	body.BorderSizePixel = 0
	body.BackgroundColor3 = Color3.new(1, 1, 1)
	body.Parent = parent
	Instance.new("UICorner", body).CornerRadius = UDim.new(0, rad)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(cols[1], cols[2])
	g.Rotation = 90
	g.Parent = body
	local stroke = Instance.new("UIStroke")
	stroke.Color = cols[3]
	stroke.Thickness = 2
	stroke.Parent = body

	local function outline(x, y, w, h, rot, r)
		local f = Instance.new("Frame")
		f.BackgroundTransparency = 1
		f.BorderSizePixel = 0
		f.Position = UDim2.fromScale(x, y)
		f.Size = UDim2.fromScale(w, h)
		if rot then f.Rotation = rot end
		Instance.new("UICorner", f).CornerRadius = UDim.new(0, r or rad)
		local st = Instance.new("UIStroke")
		st.Color = Color3.new(1, 1, 1)
		st.Transparency = 0.55
		st.Thickness = 2
		st.Parent = f
		f.Parent = body
	end
	local function dot(x, y, d)
		local f = Instance.new("Frame")
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.BorderSizePixel = 0
		f.BackgroundColor3 = Color3.new(1, 1, 1)
		f.BackgroundTransparency = 0.35
		f.Position = UDim2.fromScale(x, y)
		f.Size = UDim2.fromOffset(d, d)
		Instance.new("UICorner", f).CornerRadius = UDim.new(1, 0)
		f.Parent = body
	end
	local dd = math.max(4, math.floor(cell * 0.14))

	if kind == "Y" then
		outline(0.3, 0.3, 0.4, 0.4, 45, 4)
		dot(0.5, 0.5, dd)
	elseif kind == "V" then
		outline(0.2, 0.1, 0.6, 0.8, nil, rad)
		dot(0.5, 0.3, dd)
		dot(0.5, 0.7, dd)
	elseif kind == "H" then
		outline(0.1, 0.2, 0.8, 0.6, nil, rad)
		dot(0.3, 0.5, dd)
		dot(0.7, 0.5, dd)
	else
		local ring = Instance.new("Frame")
		ring.AnchorPoint = Vector2.new(0.5, 0.5)
		ring.BackgroundTransparency = 1
		ring.Position = UDim2.fromScale(0.5, 0.5)
		ring.Size = UDim2.fromOffset(math.floor(cell * 0.7), math.floor(cell * 0.7))
		Instance.new("UICorner", ring).CornerRadius = UDim.new(1, 0)
		local rs = Instance.new("UIStroke")
		rs.Color = Color3.new(1, 1, 1)
		rs.Transparency = 0.45
		rs.Thickness = 3
		rs.Parent = ring
		ring.Parent = body
		dot(0.5, 0.5, math.max(6, math.floor(cell * 0.2)))
		local m, L, th = 0.14, 0.16, 0.035
		for _, top in ipairs({ true, false }) do
			for _, left in ipairs({ true, false }) do
				local hx = left and m or (1 - m - L)
				local hy = top and m or (1 - m - th)
				local vx = left and m or (1 - m - th)
				local vy = top and m or (1 - m - L)
				for _, r in ipairs({ { hx, hy, L, th }, { vx, vy, th, L } }) do
					local f = Instance.new("Frame")
					f.BorderSizePixel = 0
					f.BackgroundColor3 = Color3.new(1, 1, 1)
					f.BackgroundTransparency = 0.4
					f.Position = UDim2.fromScale(r[1], r[2])
					f.Size = UDim2.fromScale(r[3], r[4])
					f.Parent = body
				end
			end
		end
	end
	return body, stroke
end

