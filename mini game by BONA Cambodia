	h.BackgroundTransparency = 1
	h.Size = UDim2.fromOffset(size, size)
	h.Parent = parent
	local function R(x, y, w, hh, c1, c2, rot, stroke)
		local f = Instance.new("Frame")
		f.BorderSizePixel = 0
		f.BackgroundColor3 = Color3.new(1, 1, 1)
		f.Position = UDim2.fromScale(x, y)
		f.Size = UDim2.fromScale(w, hh)
		f.Rotation = rot or 0
		local g = Instance.new("UIGradient")
		g.Color = ColorSequence.new(c1, c2)
		g.Rotation = 90
		g.Parent = f
		Instance.new("UICorner", f).CornerRadius = UDim.new(0.14, 0)
		if stroke then
			local st = Instance.new("UIStroke")
			st.Color = stroke
			st.Thickness = 1.5
			st.Transparency = 0.25
			st.Parent = f
		end
		f.Parent = h
		return f
	end
	local b1, b2 = Color3.fromRGB(104, 190, 255), Color3.fromRGB(22, 76, 228)
	local glow = Color3.fromRGB(170, 226, 255)
