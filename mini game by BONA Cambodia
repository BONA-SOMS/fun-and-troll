-- pieces are drawn from shapes (no fonts/images needed, works on every device)
local function drawPiece(holder, p)
	for _, ch in ipairs(holder:GetChildren()) do
		if not ch:IsA("UIAspectRatioConstraint") then ch:Destroy() end
	end
	if p == 0 then return end
	local t = math.abs(p)
	local white = p > 0
	local fill = white and Color3.fromRGB(250, 250, 250) or Color3.fromRGB(62, 62, 62)
	local line = white and Color3.fromRGB(28, 28, 28) or Color3.fromRGB(0, 0, 0)
	local accent = white and Color3.fromRGB(28, 28, 28) or Color3.fromRGB(215, 215, 215)

	local function part(x, y, w, h, round, rot)
		local f = Instance.new("Frame")
		f.BorderSizePixel = 0
		f.BackgroundColor3 = fill
		f.Size = UDim2.fromScale(w, h)
		f.Position = UDim2.fromScale(x, y)
		if rot then f.Rotation = rot end
		if round then Instance.new("UICorner", f).CornerRadius = UDim.new(round, 0) end
		local st = Instance.new("UIStroke")
		st.Color = line
		st.Thickness = 1.5
		st.Parent = f
		f.Parent = holder
		return f
	end
	local function detail(x, y, w, h, rot, round)
		local f = Instance.new("Frame")
		f.BorderSizePixel = 0
		f.BackgroundColor3 = accent
		f.Size = UDim2.fromScale(w, h)
		f.Position = UDim2.fromScale(x, y)
		if rot then f.Rotation = rot end
		if round then Instance.new("UICorner", f).CornerRadius = UDim.new(round, 0) end
		f.Parent = holder
	end

	if t == P then
		part(0.38, 0.46, 0.24, 0.32)
		part(0.22, 0.74, 0.56, 0.14, 0.4)
		part(0.3, 0.42, 0.4, 0.08, 0.5)
		part(0.34, 0.12, 0.32, 0.32, 1)
	elseif t == R then
		part(0.3, 0.34, 0.4, 0.42)
		part(0.24, 0.1, 0.14, 0.22, 0.15)
		part(0.43, 0.1, 0.14, 0.22, 0.15)
		part(0.62, 0.1, 0.14, 0.22, 0.15)
		part(0.22, 0.28, 0.56, 0.1, 0.3)
		part(0.24, 0.68, 0.52, 0.09, 0.3)
		part(0.18, 0.76, 0.64, 0.14, 0.4)
	elseif t == B then
		part(0.4, 0.45, 0.2, 0.32)
		part(0.3, 0.44, 0.4, 0.07, 0.5)
		part(0.33, 0.1, 0.34, 0.4, 1)
		part(0.44, 0.02, 0.12, 0.12, 1)
		detail(0.48, 0.16, 0.04, 0.16, 35, 0.5)
		part(0.22, 0.74, 0.56, 0.14, 0.4)
	elseif t == Q then
		for _, cx in ipairs({ 0.2, 0.35, 0.5, 0.65, 0.8 }) do
			part(cx - 0.03, 0.2, 0.06, 0.2)
			part(cx - 0.055, 0.08, 0.11, 0.11, 1)
		end
		part(0.28, 0.34, 0.44, 0.42, 0.15)
		part(0.24, 0.32, 0.52, 0.1, 0.3)
		part(0.22, 0.68, 0.56, 0.09, 0.3)
		part(0.18, 0.76, 0.64, 0.14, 0.4)
	elseif t == K then
		part(0.3, 0.4, 0.4, 0.38, 0.15)
		part(0.24, 0.34, 0.52, 0.1, 0.3)
		part(0.27, 0.22, 0.46, 0.16, 0.4)
		part(0.45, 0.02, 0.1, 0.26, 0.2)
		part(0.35, 0.08, 0.3, 0.09, 0.2)
		part(0.22, 0.68, 0.56, 0.09, 0.3)
		part(0.18, 0.76, 0.64, 0.14, 0.4)
	elseif t == N then
		part(0.38, 0.2, 0.32, 0.55, 0.2, 14)
		part(0.28, 0.46, 0.46, 0.3, 0.2)
		part(0.2, 0.13, 0.44, 0.22, 0.4, -22)
		part(0.13, 0.27, 0.26, 0.13, 0.3, -22)
		part(0.5, 0.06, 0.1, 0.14, 0.3, 12)
