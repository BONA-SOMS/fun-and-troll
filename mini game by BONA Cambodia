			play.BackgroundColor3 = Color3.new(1, 1, 1)
			play.BackgroundTransparency = 0.06
			play.TextColor3 = Color3.fromRGB(20, 80, 200)
			play.Font = Enum.Font.GothamBold
			play.TextSize = 12
			play.Size = UDim2.fromOffset(58, 22)
			play.Position = UDim2.new(1, -68, 0, 8)
			play.BorderSizePixel = 0
			play.Parent = row
			Instance.new("UICorner", play).CornerRadius = UDim.new(0.5, 0)
			strokeOf(play, Color3.fromRGB(120, 210, 255), 0, 1.5)
			play.Activated:Connect(function()
				sfx.tap()
				app.cb()
			end)
			rows[PAGE_OF[app.title]] = { frame = row, stroke = st }
		end
	end

	local function showTab(name)
		activeTab = name
		for _, ch in ipairs(list:GetChildren()) do
			if ch:IsA("Frame") then ch:Destroy() end
		end
		rows = {}
		ltitle.Text = name:upper()
		local n = 0
		for _, app in ipairs(apps) do
			if TAB_OF[app.title] == name then
				n += 1
				makeRow(app, n)
			end
		end
		for t, b in pairs(tabButtons) do
			local on = t == name
			b.btn.BackgroundTransparency = on and 0.05 or 1
			b.lbl.TextColor3 = on and Color3.new(1, 1, 1) or Color3.fromRGB(150, 190, 235)
			b.dot.BackgroundColor3 = on and Color3.new(1, 1, 1) or Color3.fromRGB(150, 190, 235)
		end
	end

	-- bottom tab bar
	local tw = math.floor((WIN_W - GAP * 2 - 12) / #TABS)
	for i, name in ipairs(TABS) do
		local btn = Instance.new("TextButton")
		btn.Text = ""
		btn.AutoButtonColor = false
		btn.Position = UDim2.fromOffset(6 + (i - 1) * tw, 5)
		btn.Size = UDim2.fromOffset(tw - 4, TAB_H - 10)
		btn.BorderSizePixel = 0
		glassFill(btn, Color3.fromRGB(60, 150, 255), Color3.fromRGB(20, 80, 210), 1)
		btn.Parent = tabBar
		Instance.new("UICorner", btn).CornerRadius = UDim.new(0.5, 0)
		local dot = Instance.new("Frame")
		dot.Size = UDim2.fromOffset(8, 8)
		dot.Rotation = 45
		dot.BorderSizePixel = 0
		dot.AnchorPoint = Vector2.new(0.5, 0.5)
		dot.Position = UDim2.new(0.5, -math.floor(#name * 4.2) - 10, 0.5, 0)
		dot.Parent = btn
		local lbl = label(btn, name, UDim2.fromScale(1, 1), UDim2.fromOffset(0, 0), 13, SOFT, Enum.Font.GothamMedium)
		lbl.TextXAlignment = Enum.TextXAlignment.Center
		tabButtons[name] = { btn = btn, lbl = lbl, dot = dot }
		btn.Activated:Connect(function()
			sfx.tap()
			showTab(name)
		end)
	end

	function selectCard(p)
		if p ~= "menu" then
			for title, page in pairs(PAGE_OF) do
				if page == p and TAB_OF[title] ~= activeTab then showTab(TAB_OF[title]) end
			end
		end
		for page, r in pairs(rows) do
			local on = page == p
			r.stroke.Transparency = on and 0.1 or 0.7
			r.stroke.Color = on and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(110, 185, 255)
		end
	end

	-- right panel when nothing is open: the BONA-FOX fox
	do
		local sz = math.floor(math.min(rightW * 0.46, contentH * 0.56))
		for i, d in ipairs({ 1.5, 1.2 }) do
			local rg = Instance.new("Frame")
			rg.AnchorPoint = Vector2.new(0.5, 0.5)
			rg.Position = UDim2.new(0.5, 0, 0.4, 0)
			rg.Size = UDim2.fromOffset(math.floor(sz * d), math.floor(sz * d))
			rg.BackgroundTransparency = 1
			rg.Parent = hero
			Instance.new("UICorner", rg).CornerRadius = UDim.new(0.5, 0)
			strokeOf(rg, Color3.fromRGB(90, 180, 255), i == 1 and 0.8 or 0.6, 2)
		end
		local logo = foxLogo(hero, sz)
		logo.AnchorPoint = Vector2.new(0.5, 0.5)
		logo.Position = UDim2.new(0.5, 0, 0.4, 0)
		local t = label(hero, "BONA-FOX ARCADE", UDim2.new(1, 0, 0, 36), UDim2.new(0, 0, 0.4, math.floor(sz * 0.62)), 26)
		t.TextXAlignment = Enum.TextXAlignment.Center
		local t2 = label(hero, "Pick a game on the left and press start", UDim2.new(1, 0, 0, 20), UDim2.new(0, 0, 0.4, math.floor(sz * 0.62) + 36), 13,
			SOFT, Enum.Font.Gotham)
		t2.TextXAlignment = Enum.TextXAlignment.Center
		local t3 = label(hero, "7 games - 120 levels in every puzzle", UDim2.new(1, 0, 0, 18), UDim2.new(0, 0, 0.4, math.floor(sz * 0.62) + 58), 12,
			Color3.fromRGB(150, 225, 255), Enum.Font.GothamMedium)
		t3.TextXAlignment = Enum.TextXAlignment.Center
	end

	-- footer: player name + FPS / ping
	do
		local mini = foxLogo(footer, FOOT_H - 4)
		mini.Position = UDim2.fromOffset(6, 2)
		label(footer, "BONA-FOX", UDim2.fromOffset(200, FOOT_H), UDim2.fromOffset(FOOT_H + 12, 0), 12)
		local pill = Instance.new("Frame")
		pill.Size = UDim2.fromOffset(150, FOOT_H - 2)
		pill.Position = UDim2.new(1, -156, 0, 1)
		pill.BorderSizePixel = 0
		glassFill(pill, Color3.fromRGB(8, 22, 84), Color3.fromRGB(4, 10, 44), 0.1)
		pill.Parent = footer
		Instance.new("UICorner", pill).CornerRadius = UDim.new(0.5, 0)
		strokeOf(pill, Color3.fromRGB(110, 185, 255), 0.6, 1)
		local dotG = Instance.new("Frame")
		dotG.Size = UDim2.fromOffset(7, 7)
		dotG.Position = UDim2.fromOffset(12, math.floor((FOOT_H - 2 - 7) / 2))
		dotG.BackgroundColor3 = Color3.new(1, 1, 1)
		dotG.BorderSizePixel = 0
		dotG.Parent = pill
		Instance.new("UICorner", dotG).CornerRadius = UDim.new(0.5, 0)
		local stat = label(pill, "-- FPS  -  -- ms", UDim2.new(1, -28, 1, 0), UDim2.fromOffset(26, 0), 11, Color3.new(1, 1, 1), Enum.Font.GothamMedium)
		local RunService = game:GetService("RunService")
		local frames, last = 0, os.clock()
		RunService.RenderStepped:Connect(function()
			frames += 1
			local now = os.clock()
			if now - last >= 0.5 then
				local fps = math.floor(frames / (now - last) + 0.5)
				frames, last = 0, now
				local okp, ping = pcall(function() return lp:GetNetworkPing() * 1000 end)
				stat.Text = ("%d FPS  -  %d ms"):format(fps, okp and math.floor(ping + 0.5) or 0)
			end
		end)
	end

	-- title bar pills: Home and Sound
	do
		local function pill(text, x, w, fn)
			local b = Instance.new("TextButton")
			b.Text = ""
			b.AutoButtonColor = false
			b.Size = UDim2.fromOffset(w, TITLE_H - 14)
			b.Position = UDim2.fromOffset(x, 4)
			b.BorderSizePixel = 0
			glassFill(b, Color3.fromRGB(34, 92, 220), Color3.fromRGB(10, 36, 132))
			b.Parent = titleBar
			Instance.new("UICorner", b).CornerRadius = UDim.new(0.5, 0)
			strokeOf(b, Color3.fromRGB(120, 195, 255), 0.35, 1.5)
			local l = label(b, text, UDim2.fromScale(1, 1), UDim2.fromOffset(0, 0), 12, Color3.new(1, 1, 1), Enum.Font.GothamBold)
			l.TextXAlignment = Enum.TextXAlignment.Center
			b.Activated:Connect(function()
				sfx.tap()
				fn(l)
			end)
		end
		local px0 = math.floor(WIN_W / 2 + math.min(300, math.floor(WIN_W * 0.36)) / 2 + 12)
		pill("Home", px0, 62, function() showPage("menu") end)
		pill(sfx.on and "Sound: On" or "Sound: Off", px0 + 70, 94, function(l)
			sfx.on = not sfx.on
			if sfx.on then sfx.tap() end
			l.Text = sfx.on and "Sound: On" or "Sound: Off"
		end)
	end

	showTab("Board")
end
buildHub()

loadLevel(1)
loadSS(1)
FW.load(1)
CS.load(1)
MC.load(1)
SN.load(1)
showPage("menu")
