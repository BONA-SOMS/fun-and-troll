local csPegs, csGeo, csStatic, csRings, csRingObj = {}, {}, {}, {}, {}
local csCap, csLvl, csMoves, csSel, csBusy, csWon, csHist, csToken = 4, 1, 0, nil, false, false, {}, 0
local csRingW, csRingH, csStep = 60, 28, 25

local function csDone(peg)
	if #peg ~= csCap then return false end
	for i = 2, #peg do
		if peg[i] ~= peg[1] then return false end
	end
	return true
end

local function csUpdate()
	if csWon then
		csStatus.Text = ("Solved in %d moves!%s"):format(csMoves, csLvl < #CSL and " Tap Next" or "")
	else
		csStatus.Text = ("Level %d/%d - Moves: %d"):format(csLvl, #CSL, csMoves)
	end
end

local function csCheck(parent, cx, cy, d)
	local c = Instance.new("Frame")
	c.AnchorPoint = Vector2.new(0.5, 0.5)
	c.Position = UDim2.fromOffset(cx, cy)
	c.Size = UDim2.fromOffset(d, d)
	c.BackgroundColor3 = Color3.fromRGB(40, 190, 70)
	c.BorderSizePixel = 0
	c.ZIndex = 6
	Instance.new("UICorner", c).CornerRadius = UDim.new(1, 0)
	local st = Instance.new("UIStroke")
	st.Color = Color3.new(1, 1, 1)
	st.Thickness = 2
	st.Parent = c
	local function seg(mx, my, len, ang)
		local f = Instance.new("Frame")
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Position = UDim2.fromScale(mx, my)
		f.Size = UDim2.fromScale(len, 0.12)
		f.Rotation = ang
		f.BorderSizePixel = 0
		f.BackgroundColor3 = Color3.new(1, 1, 1)
		f.ZIndex = 7
		Instance.new("UICorner", f).CornerRadius = UDim.new(1, 0)
		f.Parent = c
	end
	seg(0.355, 0.595, 0.24, 45)
	seg(0.585, 0.5, 0.48, -48)
	c.Parent = parent
	return c
end

local function csRender()
	for _, o in ipairs(csRings) do o:Destroy() end
	csRings, csRingObj = {}, {}
	for k, peg in ipairs(csPegs) do
		local g = csGeo[k]
		csRingObj[k] = {}
		for i, ch in ipairs(peg) do
			local f = buildRing(csBoard, CS_COL[ch], csRingW, csRingH)
			local lifted = (csSel == k and i == #peg)
			f.Position = UDim2.fromOffset(g.cx, lifted and g.lift or (g.base - i * csStep))
			f.ZIndex = lifted and 8 or 3
			csRingObj[k][i] = f
			csRings[#csRings + 1] = f
		end
		if csDone(peg) then
			csRings[#csRings + 1] = csCheck(csBoard, g.cx, g.base - csCap * csStep / 2, math.floor(csRingH * 1.2))
		end
	end
end

local function csCheckWin()
	for _, peg in ipairs(csPegs) do
		if #peg > 0 and not csDone(peg) then return false end
	end
	return true
end

local function csTap(k)
	if csBusy or csWon then return end
	local peg = csPegs[k]
	if not csSel then
		if #peg == 0 or csDone(peg) then return end
		csSel = k
		csRender()
		return
	end
	if csSel == k then
		csSel = nil
		csRender()
		return
	end
	local from = csSel
	local src = csPegs[from]
	local c = src[#src]
	if #peg < csCap and (#peg == 0 or peg[#peg] == c) then
		csBusy = true
		local tk = csToken
		local obj = csRingObj[from][#src]
		TweenService:Create(obj, TweenInfo.new(0.14, Enum.EasingStyle.Quad),
			{ Position = UDim2.fromOffset(csGeo[k].cx, csGeo[k].lift) }):Play()
		task.wait(0.15)
		if tk ~= csToken then return end
		table.remove(src)
		table.insert(peg, c)
		csSel = nil
		csMoves += 1
		csHist[#csHist + 1] = { from, k }
		csRender()
		local o = csRingObj[k][#peg]
		local rest = o.Position
		o.Position = UDim2.fromOffset(csGeo[k].cx, csGeo[k].lift)
		TweenService:Create(o, TweenInfo.new(0.12, Enum.EasingStyle.Quad), { Position = rest }):Play()
		task.wait(0.13)
		if tk ~= csToken then return end
		csBusy = false
		if csCheckWin() then csWon = true end
		csUpdate()
		if csWon then celebrate(csLvl < #CSL and "Level complete!" or "All levels complete!") end
	else
		if #peg > 0 and not csDone(peg) then csSel = k else csSel = nil end
		csRender()
	end
end

local function csUndo()
	if csBusy or #csHist == 0 then return end
	local h = table.remove(csHist)
	local ring = table.remove(csPegs[h[2]])
	table.insert(csPegs[h[1]], ring)
	csMoves -= 1
	csSel = nil
	csWon = false
	csRender()
	csUpdate()
end

local function loadCS(idx)
	csToken += 1
	csLvl, csMoves, csSel, csBusy, csWon, csHist = idx, 0, nil, false, false, {}
	for _, o in ipairs(csStatic) do o:Destroy() end
	csStatic = {}
	local lv = CSL[idx]
	csCap = lv.cap
	csPegs = {}
	for tok in lv.pegs:gmatch("%S+") do
		local t = {}
		if tok ~= "-" then
			for ch in tok:gmatch(".") do t[#t + 1] = ch end
		end
		csPegs[#csPegs + 1] = t
	end
	local np = #csPegs
	local perRow = math.ceil(np / 2)
	local rowH = math.floor(S / 2)
	local pegW = math.floor(S / perRow)
	csRingW = math.min(math.floor(pegW * 0.84), math.floor(S * 0.2))
	csRingH = math.floor(rowH * 0.125)
	csStep = math.floor(csRingH * 0.9)
	local plankH = math.max(8, math.floor(rowH * 0.07))
	local rodH = math.floor(csCap * csStep + csRingH * 0.7)
	local rodW = math.max(8, math.floor(csRingW * 0.14))

	local function add(o)
		csStatic[#csStatic + 1] = o
		return o
	end
	csGeo = {}
	for row = 0, 1 do
		local cnt = (row == 0) and perRow or (np - perRow)
		if cnt > 0 then
			local plank = add(Instance.new("Frame"))
			plank.BorderSizePixel = 0
			plank.BackgroundColor3 = Color3.fromRGB(228, 188, 142)
			plank.Position = UDim2.fromOffset(6, row * rowH + rowH - plankH)
			plank.Size = UDim2.fromOffset(S - 12, plankH)
			plank.ZIndex = 2
			Instance.new("UICorner", plank).CornerRadius = UDim.new(0, 4)
			local ps = Instance.new("UIStroke")
			ps.Color = Color3.fromRGB(140, 92, 52)
			ps.Thickness = 2
			ps.Parent = plank
			plank.Parent = csBoard
		end
	end
	for k = 1, np do
		local row = (k > perRow) and 1 or 0
		local cnt = (row == 0) and perRow or (np - perRow)
		local inRow = k - row * perRow - 1
		local startX = math.floor((S - cnt * pegW) / 2)
		local cx = startX + inRow * pegW + math.floor(pegW / 2)
		local rowTop = row * rowH
		local base = rowTop + rowH - plankH
		csGeo[k] = { cx = cx, base = base, lift = base - rodH - csRingH - 6 }

		local rod = add(Instance.new("Frame"))
		rod.AnchorPoint = Vector2.new(0.5, 0)
		rod.BorderSizePixel = 0
		rod.BackgroundColor3 = Color3.fromRGB(232, 196, 150)
		rod.Position = UDim2.fromOffset(cx, base - rodH)
		rod.Size = UDim2.fromOffset(rodW, rodH)
		rod.ZIndex = 1
		Instance.new("UICorner", rod).CornerRadius = UDim.new(0, 4)
		local rs = Instance.new("UIStroke")
		rs.Color = Color3.fromRGB(150, 100, 56)
		rs.Thickness = 2
		rs.Parent = rod
		rod.Parent = csBoard

		local btn = add(Instance.new("TextButton"))
		btn.Text = ""
		btn.AutoButtonColor = false
		btn.BackgroundTransparency = 1
		btn.BorderSizePixel = 0
		btn.Position = UDim2.fromOffset(cx - math.floor(pegW / 2), rowTop)
		btn.Size = UDim2.fromOffset(pegW, rowH)
		btn.ZIndex = 10
		btn.Parent = csBoard
		btn.Activated:Connect(function() csTap(k) end)
	end
	csRender()
	csUpdate()
end

return {
	page = csPage, load = loadCS, undo = csUndo, count = #CSL,
	lvl = function() return csLvl end, col = CS_COL, ring = buildRing,
}
end)()

