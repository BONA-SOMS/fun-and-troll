-- A ring can go on an empty peg or on a ring of the same colour. Fill every peg with ONE colour.
------------------------------------------------------------------
local CS = (function()
local CS_COL = {
	a = Color3.fromRGB(232, 44, 44),   b = Color3.fromRGB(250, 150, 24),  c = Color3.fromRGB(250, 220, 44),
	d = Color3.fromRGB(52, 198, 72),   e = Color3.fromRGB(44, 150, 250),  f = Color3.fromRGB(160, 76, 226),
	g = Color3.fromRGB(150, 92, 52),   h = Color3.fromRGB(250, 112, 184), i = Color3.fromRGB(40, 214, 206),
	j = Color3.fromRGB(236, 236, 242),
}
-- each peg is written bottom -> top, "-" = empty peg (all levels checked: they can be solved)
local CSL = {
	{ cap = 4, pegs = "ccba - acbb - abca" },
	{ cap = 4, pegs = "- bcdb dcbd - acac adab" },
	{ cap = 4, pegs = "ebcb - caed bced daea - dcba" },
	{ cap = 4, pegs = "feca - bccb - fdae addc abdf efeb" },
	{ cap = 5, pegs = "cdfea - afccb abddd eebfa deabe bfccf -" },
	{ cap = 5, pegs = "adfgc ghehd bfbae bdchc aegcf ffcga - abheh - bdegd" },
	{ cap = 5, pegs = "- bhhie fhcfg dciai ibcgb edffe badec - fbhed ighag gcada" },
}

local function shade(c, f)
	return Color3.new(math.clamp(c.R * f, 0, 1), math.clamp(c.G * f, 0, 1), math.clamp(c.B * f, 0, 1))
end

local function buildRing(parent, col, w, h)
	local f = Instance.new("Frame")
	f.AnchorPoint = Vector2.new(0.5, 0)
	f.Size = UDim2.fromOffset(w, h)
	f.BorderSizePixel = 0
	f.BackgroundColor3 = Color3.new(1, 1, 1)
	Instance.new("UICorner", f).CornerRadius = UDim.new(0.5, 0)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(shade(col, 1.2), shade(col, 0.72))
	g.Rotation = 90
	g.Parent = f
	local st = Instance.new("UIStroke")
	st.Color = shade(col, 0.5)
	st.Thickness = 2
	st.Parent = f
	local hole = Instance.new("Frame")
	hole.BorderSizePixel = 0
	hole.BackgroundColor3 = shade(col, 0.42)
	hole.Position = UDim2.fromScale(0.27, 0.16)
	hole.Size = UDim2.fromScale(0.46, 0.34)
	Instance.new("UICorner", hole).CornerRadius = UDim.new(0.5, 0)
	hole.Parent = f
	local hi = Instance.new("Frame")
	hi.BorderSizePixel = 0
	hi.BackgroundColor3 = Color3.new(1, 1, 1)
	hi.BackgroundTransparency = 0.55
	hi.Position = UDim2.fromScale(0.12, 0.58)
	hi.Size = UDim2.fromScale(0.4, 0.16)
	Instance.new("UICorner", hi).CornerRadius = UDim.new(0.5, 0)
	hi.Parent = f
	f.Parent = parent
	return f
end

