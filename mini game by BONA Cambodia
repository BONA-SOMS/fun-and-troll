function ssCanMove(p, dr, dc)
	local nr, nc = p.r + dr, p.c + dc
	if nr < 1 or nc < 1 or nr + p.h - 1 > 5 or nc + p.w - 1 > 4 then return false end
	for i = 0, p.h - 1 do
		for j = 0, p.w - 1 do
			local o = ssOcc[nr + i][nc + j]
			if o and o ~= p then return false end
		end
	end
	return true
end

function ssStep(p, dr, dc)
	if ssLocked or not ssCanMove(p, dr, dc) then return false end
	for i = 0, p.h - 1 do
		for j = 0, p.w - 1 do ssOcc[p.r + i][p.c + j] = false end
	end
	p.r += dr; p.c += dc
	for i = 0, p.h - 1 do
		for j = 0, p.w - 1 do ssOcc[p.r + i][p.c + j] = p end
	end
	TweenService:Create(p.btn, TweenInfo.new(0.1, Enum.EasingStyle.Quad),
		{ Position = UDim2.fromOffset((p.c - 1) * sCell, (p.r - 1) * sCell) }):Play()
	ssMoves += 1
	ssUpdate()
	if p.kind == "R" and p.r == 4 and p.c == 2 then
		ssLocked = true
		local par = SSL[ssLvl].par
		local txt = ("Solved in %d moves"):format(ssMoves)
		if ssMoves <= par then txt ..= " - perfect!" end
		if ssLvl < #SSL then txt ..= " Tap Next" end
		ssStatus.Text = txt
		celebrate(ssLvl < #SSL and "Level complete!" or "All levels complete!")
	end
	return true
end

function ssSelect(p)
	if ssSel then
		ssSel.stroke.Color = BLOCKC[ssSel.kind][3]
		ssSel.stroke.Thickness = 2
	end
	ssSel = p
	if p then
		p.stroke.Color = Color3.new(1, 1, 1)
		p.stroke.Thickness = 4
	end
end

