-- sound effects: soft clicks, pops, chimes in musical notes and a fanfare.
-- Every sound is checked on this device first; if one is missing the next one in its list is used.
local sfx = { on = true }
do
	local Debris = game:GetService("Debris")
	local CP = game:GetService("ContentProvider")
	local LISTS = {
		click = { "rbxassetid://6895079853", "rbxasset://sounds/switch.mp3", "rbxasset://sounds/button.mp3",
			"rbxasset://sounds/clickfast.wav", "rbxasset://sounds/snap.mp3" },
		chime = { "rbxasset://sounds/electronicpingshort.wav", "rbxasset://sounds/electronicpingshort.mp3",
			"rbxassetid://12222216", "rbxassetid://12221967" },
		thud = { "rbxasset://sounds/action_jump_land.mp3", "rbxasset://sounds/impact_water.mp3",
			"rbxasset://sounds/clickfast.wav" },
		oof = { "rbxasset://sounds/uuhhh.mp3", "rbxasset://sounds/action_falling.mp3" },
	}
	local ids = {}
	task.spawn(function()
		for kind, list in pairs(LISTS) do
			for _, id in ipairs(list) do
				local t = Instance.new("Sound")
				t.SoundId = id
				t.Parent = gui
				pcall(function() CP:PreloadAsync({ t }) end)
				local ok = t.IsLoaded and t.TimeLength > 0
				t:Destroy()
				if ok then
					ids[kind] = id
					break
				end
			end
		end
		ids.chime = ids.chime or ids.click
		ids.click = ids.click or ids.chime
		ids.thud = ids.thud or ids.click
		ids.oof = ids.oof or ids.thud
	end)
	local function note(kind, speed, vol, delay)
		local function go()
			if not sfx.on or not ids[kind] then return end
			local snd = Instance.new("Sound")
			snd.SoundId = ids[kind]
			snd.PlaybackSpeed = speed
			snd.Volume = vol or 0.4
			snd.Parent = gui
			snd:Play()
			Debris:AddItem(snd, 3)
		end
		if delay and delay > 0 then task.delay(delay, go) else go() end
	end
	local function st(n) return 2 ^ (n / 12) end -- musical steps
	function sfx.tap() note("click", 1, 0.3) end
	function sfx.move() note("click", 0.85, 0.35) end
	function sfx.flip() note("click", 1.4, 0.3) end
	function sfx.drop() note("thud", 1.3, 0.35) end
	function sfx.capture() note("thud", 0.9, 0.55); note("click", 0.7, 0.35, 0.04) end
	function sfx.bad() note("thud", 0.7, 0.45); note("click", 0.6, 0.35, 0.05) end
	function sfx.match() note("chime", st(4), 0.4); note("chime", st(7), 0.4, 0.1) end
	function sfx.eat() note("chime", st(7), 0.4); note("chime", st(12), 0.35, 0.07) end
	function sfx.win()
		for i, n in ipairs({ 0, 4, 7, 12 }) do note("chime", st(n), 0.45, (i - 1) * 0.1) end
		for _, n in ipairs({ 12, 16, 19 }) do note("chime", st(n), 0.4, 0.5) end
	end
	function sfx.lose()
		note("oof", 1, 0.8)
		note("thud", 0.6, 0.5, 0.35)
		note("chime", st(-5), 0.3, 0.55)
	end
end

