local levelIdx, n, grid, emptyR, emptyC = 1, 3, {}, 1, 1
local moves, sLocked, slideId = 0, false, 0
local tileList = {}

local function cellCenter(r, c)
	return UDim2.fromScale((c - 0.5) / n, (r - 0.5) / n)
end

local function trace()
	local sr, sc
	for r = 1, n do
		for c = 1, n do
			local t = grid[r][c]
			if t and t.kind == "start" then sr, sc = r, c end
		end
	end
	if not sr then return {}, false end
	local path = { { sr, sc } }
	local r, c = sr, sc
	local exitBit = grid[r][c].mask
	for _ = 1, n * n + 2 do
		local d
		for _, dd in ipairs(DIRS) do
			if dd[3] == exitBit then d = dd end
		end
		if not d then return path, false end
		local nr, nc = r + d[1], c + d[2]
		local t = nr >= 1 and nr <= n and nc >= 1 and nc <= n and grid[nr][nc]
		if not t or bit32.band(t.mask, d[4]) == 0 then return path, false end
		path[#path + 1] = { nr, nc }
		if t.kind == "end" then return path, true end
		exitBit = bit32.band(t.mask, bit32.bnot(d[4]))
		r, c = nr, nc
	end
	return path, false
end

-- slide the tile at (r,c) (and any tiles between it and the empty slot) into the empty slot
local function tryMove(r, c, anim)
	if not grid[r][c] or grid[r][c].fixed then return false end
	local dr, dc
	if r == emptyR and c ~= emptyC then
		dr, dc = 0, (emptyC > c) and 1 or -1
	elseif c == emptyC and r ~= emptyR then
		dr, dc = (emptyR > r) and 1 or -1, 0
	else
		return false
	end
	local list = {}
	local cr, cc = r, c
	while not (cr == emptyR and cc == emptyC) do
		local t = grid[cr][cc]
		if t.fixed then return false end
		list[#list + 1] = t
		cr += dr; cc += dc
	end
	for k = #list, 1, -1 do
		local t = list[k]
		t.r += dr; t.c += dc
		grid[t.r][t.c] = t
	end
	grid[r][c] = false
	emptyR, emptyC = r, c
	if anim then
		for _, t in ipairs(list) do
			TweenService:Create(t.btn, TweenInfo.new(0.12, Enum.EasingStyle.Quad),
				{ Position = UDim2.fromScale((t.c - 1) / n, (t.r - 1) / n) }):Play()
		end
	end
	return true
end

local function updateStatus()
	if moves == 0 then
		sStatus.Text = ("Level %d/%d - connect the ball to the red tile"):format(levelIdx, #SLEVELS)
	else
		sStatus.Text = ("Level %d/%d - Moves: %d"):format(levelIdx, #SLEVELS, moves)
	end
end

local function checkSolved()
	local path, ok = trace()
	if not ok then return end
	sLocked = true
	local id = slideId
	task.spawn(function()
		task.wait(0.2)
		sStatus.Text = "Rolling..."
		for i = 2, #path do
			if id ~= slideId then return end
			local tw = TweenService:Create(ball, TweenInfo.new(0.2, Enum.EasingStyle.Linear),
				{ Position = cellCenter(path[i][1], path[i][2]) })
			tw:Play()
			tw.Completed:Wait()
		end
		if id ~= slideId then return end
		TweenService:Create(ball, TweenInfo.new(0.2), { Size = UDim2.fromScale(0, 0) }):Play()
		task.wait(0.25)
		if id ~= slideId then return end
		if levelIdx < #SLEVELS then
			sStatus.Text = ("Level %d complete in %d moves - tap Next"):format(levelIdx, moves)
			celebrate("Level complete!")
		else
			sStatus.Text = ("All levels complete! (%d moves)"):format(moves)
			celebrate("All levels complete!")
		end
	end)
end

local function onTile(t)
	if sLocked then return end
	if tryMove(t.r, t.c, true) then
		moves += 1
		updateStatus()
		checkSolved()
	end
end

local function loadLevel(idx)
	slideId += 1
	sLocked = false
	levelIdx = idx
	moves = 0
	for _, t in ipairs(tileList) do t.btn:Destroy() end
	tileList = {}
	local rows = SLEVELS[idx]
	n = #rows
	grid = {}
	for r, rowStr in ipairs(rows) do
		grid[r] = {}
		local c = 0
		for tok in rowStr:gmatch("%S+") do
			c += 1
			local t = parseTok(tok)
			if t then
				t.r, t.c = r, c
			else
				emptyR, emptyC = r, c
			end
			grid[r][c] = t
		end
	end

	-- shuffle with random legal slides (always solvable) until the path is broken
	local tries = 0
	repeat
		for _ = 1, 60 + n * 20 do
			local r, c
			if math.random(2) == 1 then r, c = emptyR, math.random(n) else r, c = math.random(n), emptyC end
			tryMove(r, c, false)
		end
		local _, ok = trace()
		tries += 1
	until not ok or tries > 20

	local sr, sc = 1, 1
	for r = 1, n do
		for c = 1, n do
			local t = grid[r][c]
			if t then
				local btn = Instance.new("TextButton")
				btn.Text = ""
				btn.AutoButtonColor = false
				btn.BackgroundTransparency = 1
				btn.BorderSizePixel = 0
				btn.Size = UDim2.fromScale(1 / n, 1 / n)
				btn.Position = UDim2.fromScale((c - 1) / n, (r - 1) / n)
				btn.Parent = sBoard
				buildTile(btn, t)
				t.btn = btn
				tileList[#tileList + 1] = t
				btn.Activated:Connect(function() onTile(t) end)
				if t.kind == "start" then sr, sc = r, c end
			end
		end
	end
	ball.Size = UDim2.fromScale(0.42 / n, 0.42 / n)
	ball.Position = cellCenter(sr, sc)
	ball.Visible = true
	updateStatus()
end

