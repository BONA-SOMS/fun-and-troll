local function shade(c, f)
	return Color3.new(math.clamp(c.R * f, 0, 1), math.clamp(c.G * f, 0, 1), math.clamp(c.B * f, 0, 1))
end

local function buildRing(parent, col, w, h)
	local f = Instance.new("Frame")
	f.AnchorPoint = Vector2.new(0.5, 0)
	f.Size = UDim2.fromOffset(w, h)
	f.BorderSizePixel = 0
	f.BackgroundColor3 = Color3.new(1, 1, 1)
	Instance.new("UICorner", f).CornerRadius = UDim.new(0.5, 0)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(shade(col, 1.2), shade(col, 0.72))
	g.Rotation = 90
	g.Parent = f
	local st = Instance.new("UIStroke")
	st.Color = shade(col, 0.5)
	st.Thickness = 2
	st.Parent = f
	local hole = Instance.new("Frame")
	hole.BorderSizePixel = 0
	hole.BackgroundColor3 = shade(col, 0.42)
	hole.Position = UDim2.fromScale(0.27, 0.16)
	hole.Size = UDim2.fromScale(0.46, 0.34)
	Instance.new("UICorner", hole).CornerRadius = UDim.new(0.5, 0)
	hole.Parent = f
	local hi = Instance.new("Frame")
	hi.BorderSizePixel = 0
	hi.BackgroundColor3 = Color3.new(1, 1, 1)
	hi.BackgroundTransparency = 0.55
	hi.Position = UDim2.fromScale(0.12, 0.58)
	hi.Size = UDim2.fromScale(0.4, 0.16)
	Instance.new("UICorner", hi).CornerRadius = UDim.new(0.5, 0)
	hi.Parent = f
	f.Parent = parent
	return f
end

