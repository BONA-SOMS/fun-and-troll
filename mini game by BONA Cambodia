local function buildCard(parent, size, border, id, up)
	local card = Instance.new("Frame")
	card.AnchorPoint = Vector2.new(0.5, 0.5)
	card.Size = UDim2.fromOffset(size, size)
	card.BackgroundColor3 = border
	card.BorderSizePixel = 0
	card.Parent = parent
	Instance.new("UICorner", card).CornerRadius = UDim.new(0, math.max(6, math.floor(size * 0.12)))

	local face = Instance.new("Frame")
	face.AnchorPoint = Vector2.new(0.5, 0.5)
	face.Position = UDim2.fromScale(0.5, 0.5)
	face.Size = UDim2.fromScale(0.84, 0.84)
	face.BackgroundColor3 = Color3.new(1, 1, 1)
	face.BorderSizePixel = 0
	face.Visible = up
	face.Parent = card
	Instance.new("UICorner", face).CornerRadius = UDim.new(0, math.max(4, math.floor(size * 0.08)))
	local holder = Instance.new("Frame")
	holder.AnchorPoint = Vector2.new(0.5, 0.5)
	holder.Position = UDim2.fromScale(0.5, 0.5)
	holder.Size = UDim2.fromScale(0.86, 0.86)
	holder.BackgroundTransparency = 1
	holder.Parent = face
	drawIcon(holder, id)

	local back = Instance.new("Frame")
	back.AnchorPoint = Vector2.new(0.5, 0.5)
	back.Position = UDim2.fromScale(0.5, 0.5)
	back.Size = UDim2.fromScale(0.84, 0.84)
	back.BackgroundColor3 = Color3.fromRGB(255, 246, 232)
	back.BorderSizePixel = 0
	back.Visible = not up
	back.Parent = card
	Instance.new("UICorner", back).CornerRadius = UDim.new(0, math.max(4, math.floor(size * 0.08)))
	for i = 0, 2 do
		for j = 0, 2 do
			local d = Instance.new("Frame")
			d.BorderSizePixel = 0
			d.BackgroundColor3 = Color3.fromRGB(255, 160, 50)
			d.Position = UDim2.fromScale(0.08 + i * 0.3, 0.08 + j * 0.3)
			d.Size = UDim2.fromScale(0.22, 0.22)
			Instance.new("UICorner", d).CornerRadius = UDim.new(0.5, 0)
			d.Parent = back
		end
	end
	return card, face, back
end

